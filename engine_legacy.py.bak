"""Framework-independent game rules used by both UI clients."""

from __future__ import annotations

import re
import time
from collections.abc import Callable

from models import OBJECTIVES, ROOMS, Player


class GameEngine:
    """Owns game state and rules; it knows nothing about Tkinter or the CLI."""

    def __init__(
        self,
        output: Callable[[str], None] | None = None,
        day_seconds: int = 10 * 60,
        pump_deadline_seconds: int = 2 * 60,
        cavitation_deadline_seconds: int = 90,
    ) -> None:
        self.output = output or print
        self.player = Player()
        self.chapter = 0
        self.room = "indgangen"
        self.flags: set[str] = set()
        self.running = True
        self.max_help_calls = 3
        self.help_calls = 0
        self.workdays = 5
        self.work_hours_per_day = 8
        self.day_seconds = day_seconds
        self.timer_seconds = self.workdays * self.day_seconds
        self.pump_deadline_seconds = pump_deadline_seconds
        self.cavitation_deadline_seconds = cavitation_deadline_seconds
        self.timer_started_at = 0.0
        self.pump_deadline_started_at = 0.0
        self.pump_deadline_active = False
        self.cavitation_deadline_started_at = 0.0
        self.cavitation_deadline_active = False

        # Cascading systemic consequence flags
        self.breaker_tripped: bool = False
        self.scada_blind: bool = False
        self.plc_defect_stop: bool = False
        self.scada_log_interrupted: bool = False

    def emit(self, message: str) -> None:
        try:
            self.output(message)
        except UnicodeEncodeError:
            safe = message.encode("ascii", errors="replace").decode("ascii")
            self.output(safe)

    def start(self, name: str, education: str) -> None:
        self.player.name = name or "Den nye konsulent"
        self.player.education = education or "en stærk teknisk uddannelse"
        self.chapter = 1

        self.emit(
            f"Jens Majer, direktør: \"Velkommen til Nordic H2O Utility, {self.player.name}. "
            f"Jeg har med glæde noteret mig din baggrund inden for {self.player.education}.\""
        )
        self.emit(
            "Jens: \"Situationen er alvorlig: Om fem arbejdsdage kommer Miljø- og Cybersikkerhedstilsynet "
            "for at kontrollere os efter NIS2-direktivet (EU 2022/2555) og IEC 62443-standarden. "
            "Hvis vi dumper, trækkes vores driftstilladelse tilbage!\""
        )
        self.emit(
            "Jens: \"Værre endnu: En ukendt trusselsaktør har allerede fået foden indenfor og saboterer driften. "
            "Vi har brug for en skarp teknolog, der forstår både PLC'er, netværkssegmentering, "
            "industrielle protokoller og dokumentation.\""
        )
        self.emit(
            f"HR-chefen nikker: \"Du er hermed hyret som Lead OT-Sikkerhedskonsulent, {self.player.name}. "
            "Undersøg anlægget, stop angrebene metodisk, og opbyg dokumentationen til revisoren.\""
        )
        self.emit(
            "Ved hovedindgangen tager Hans McDonald, senior driftstekniker, imod dig med sin kaffekop: "
            "\"Velkommen om bord! Du står ved Hovedindgangen. Før du rører ved noget, anbefaler jeg, at du "
            "kigger dig omkring eller tager vores 'Rundtur' for at lære zonerne at kende. "
            "Gå mod Pumpehuset i produktionshallen, når du er klar til at gå i gang med anlægget.\""
        )
        self.describe_room()
        # Start the overall 5-day week clock, but leave acute pump deadline inactive until entering Pumpehuset!
        self.timer_started_at = time.monotonic()
        self.pump_deadline_active = False
        self.pump_deadline_started_at = 0.0

    def describe_room(self) -> None:
        room_obj = ROOMS[self.room]
        self.emit(f"[{room_obj.title.upper()} - {room_obj.purdue_level}]")
        self.emit(room_obj.description)
        choices_text = self.format_choices_text()
        if choices_text:
            self.emit(choices_text)

    def format_choices_text(self) -> str:
        choices = self.get_current_choices()
        if not choices:
            return ""
        lines = ["\n⚡ TILGÆNGELIGE HANDLINGER (Tast tal eller vælg i kontrolpanelet):"]
        for key, label, _cmd, _cat in choices:
            lines.append(f"  [{key}] {label}")
        return "\n".join(lines)

    def execute_choice(self, key: str) -> bool:
        norm_key = key.lower().strip()
        choices = self.get_current_choices()
        for k, label, cmd, _cat in choices:
            if norm_key == k.lower().strip():
                self.emit(f"\n👉 [VALG {k}]: {label}")
                self.handle_command(cmd)
                return True
        return False

    def handle_command(self, command: str) -> None:
        if not self.check_timers():
            return
        normalized = re.sub(r"\s+", " ", command.lower().strip())
        if not normalized:
            return

        # Check if user entered a numbered or lettered choice
        if normalized in {"1", "2", "3", "4", "5", "6", "7", "8", "9", "a", "b", "c", "d", "e"}:
            if self.execute_choice(normalized):
                return

        # General game queries
        if normalized in {"hjælp", "help", "?"}:
            self.help()
        elif normalized in {"rundtur", "introduktion", "tour", "gennemgang"}:
            self.tour()
        elif normalized in {"techsupport", "tech support", "ring techsupport", "ring support"}:
            self.call_tech_support()
        elif normalized in {"status", "mål", "mission"}:
            self.status()
        elif normalized in {"tid", "time", "ur", "clock"}:
            self.show_time()
        elif normalized in {"inventory", "inventar", "rygsæk", "taske"}:
            self.emit("[RYGSÆK] Din rygsæk indeholder: " + ", ".join(sorted(self.player.inventory)))
        elif normalized in {"åbn laptop", "åbn laptopen", "open laptop", "laptop"}:
            self.open_laptop()
        elif normalized in {"topologi", "netværk", "netværksdiagram", "purdue", "arkitektur"}:
            self.open_tool("topologi")
        elif normalized in {"nis2", "dokumentation", "audit status", "rapport"}:
            self.open_tool("nis2")
        elif normalized.startswith(("åbn ", "open ")):
            self.open_tool(normalized.removeprefix("åbn ").removeprefix("open "))
        elif normalized.startswith("undersøg "):
            self.inspect(normalized.removeprefix("undersøg "))
        elif normalized.startswith("tal med "):
            self.talk_to(normalized.removeprefix("tal med "))
        elif normalized.startswith("gå til "):
            self.go_to(normalized.removeprefix("gå til "))
        elif normalized.startswith("brug ") and " på " in normalized:
            item, target = normalized.removeprefix("brug ").split(" på ", 1)
            self.use(item.strip(), target.strip())
        elif normalized in {"afslut", "quit", "exit"}:
            self.emit("Du lukker laptoppen. Auditoren må vente på en ny helt.")
            self.running = False
        elif normalized in {"revisor", "audit", "tilsyn"} and self.chapter == 5:
            self.complete_audit()
        elif self.handle_natural_action(normalized):
            pass
        else:
            self.emit("Den kommando genkender HMI'et ikke. Prøv HJÆLP eller NÆSTE SKRIDT.")

    def handle_natural_action(self, cmd: str) -> bool:
        """Handle domain-specific direct commands for intuitive gameplay."""
        # Cascading systemic consequence actions & remediations
        if any(k in cmd for k in {
            "hård nødnedlukning", "hård nedlukning", "hård afbrydelse", "sluk vfd",
            "træk afbryder", "hovedafbryder", "nødstop vfd", "hård nedlukning af vfd",
            "hård nødnedlukning af vfd", "træk hovedafbryderen", "sluk frekvensomformer"
        }):
            self.hard_shutdown_vfd()
            return True

        if any(k in cmd for k in {
            "nulstil sikkerhedsrelæ", "nulstil relæ", "reset relæ", "reset k1",
            "nulstil k1", "nulstil sikkerhedsrelæ k1", "reset sikkerhedsrelæ",
            "aktiver k1", "k1 reset"
        }):
            self.reset_safety_breaker()
            return True

        if any(k in cmd for k in {
            "bloker port 502 totalt", "bloker port 502", "drop port 502",
            "bloker al port 502", "bloker al tcp port 502", "drop tcp 502",
            "spær port 502", "luk port 502"
        }):
            self.block_port_502_blindly()
            return True

        if any(k in cmd for k in {
            "fix scada filter", "juster firewall", "skift til dpi", "modbus dpi",
            "tillad fc03", "optimer modbus filter", "juster modbus filter",
            "tillad fc 03", "aktiver modbus dpi"
        }):
            self.fix_scada_filter()
            return True

        if any(k in cmd for k in {
            "tving cpu i run", "tving i run", "drej til run", "tving run",
            "sæt cpu i run uden ændringer", "run uden backup", "skift til run uden ændringer",
            "tving s7-1500 i run"
        }):
            self.force_run_without_protection()
            return True

        if any(k in cmd for k in {
            "gendan plc db1", "gendan db1", "gendan fra usb", "indlæs backup",
            "restore db1", "gendan db1 fra usb", "indlæs db1 fra backup"
        }):
            self.restore_plc_db1()
            return True

        if any(k in cmd for k in {
            "bloker port 4840 totalt", "bloker port 4840", "drop port 4840",
            "luk port 4840", "spær port 4840", "bloker al port 4840"
        }):
            self.block_port_4840_blindly()
            return True

        if any(k in cmd for k in {
            "gendan opc logning", "aktiver mtls", "konfigurer mtls", "x.509 mtls",
            "genopret opc logning", "aktiver certifikater på opc"
        }):
            self.restore_opc_logging()
            return True

        if any(k in cmd for k in {
            "juster setpunkt", "drej potmeter", "manuelt setpunkt", "skru ned for vfd",
            "tast 50 hz", "sæt 50 hz", "juster frekvens", "manuel overstyring", "skru ned"
        }):
            self.manual_vfd_adjustment_fails()
            return True

        if any(k in cmd for k in {
            "genstart et200sp", "reboot et200sp", "nulstil et200sp", "genstart ventiler",
            "reboot ventiler", "afbryd strøm til ventiler", "genstart ventil-ø"
        }):
            self.reboot_et200sp_fails()
            return True

        # Chapter 1: Modbus & Firewall
        if self.chapter == 1:
            if any(k in cmd for k in {
                "konfigurer firewall", "opsæt firewall", "installer firewall",
                "konfigurer scalance", "monter scalance", "monter firewall",
                "isoler frekvensomformer", "isoler vfd", "opsæt vlan",
                "aktiver dpi", "kobl frekvensomformer til firewall",
                "tilslut firewall", "opsæt modbus firewall regel"
            }):
                self.use("firewall", "frekvensomformer")
                return True

        # Chapter 2: PROFINET & Rogue Pi / Switch
        if self.chapter == 2:
            # Action: Pille switch fra (rash disconnect -> triggers acute cavitation threat)
            if any(k in cmd for k in {
                "pille switch fra", "pille d-link fra", "frakobl switch", "kobl switch fra",
                "tag switch ud", "afbryd switch", "afbryd d-link", "frakobl d-link",
                "sluk switch", "fjern switch", "træk kabler ud af switch", "pille switch ud",
                "tag d-link ud", "afbryd d-link switch", "frakobl d-link switch"
            }):
                if "pi-removed" not in self.flags:
                    self.disconnect_switch_rashly()
                    return True
                else:
                    self.emit("Du kobler den gamle unmanaged D-Link switch fra kabelbakken. Netværket er klar til SCALANCE XB-200.")
                    return True

            # Action: Fjern rogue Raspberry Pi
            if any(k in cmd for k in {
                "fjern raspberry pi", "frakobl rogue raspberry pi", "kobl raspberry pi fra",
                "fjern rogue pi", "tag raspberry pi ud", "afbryd rogue pi",
                "fjern rogue enhed", "fjern angriber", "pille pi fra", "kobl pi fra",
                "frakobl pi", "tag pi ud", "fjern pi", "pille raspberry pi fra",
                "konfisker raspberry pi", "frakobl rogue enhed"
            }):
                self.remove_rogue_pi()
                return True

            # Action: Udskift switch / installer SCALANCE
            if any(k in cmd for k in {
                "udskift switch", "udskift unmanaged switch", "installer scalance switch",
                "aktiver mrp", "aktiver port security", "lås dcp i tia portal",
                "installer managed switch", "skift switch", "brug scalance",
                "udskift d-link med scalance", "udskift d-link switch med scalance",
                "udskift d-link", "erstat d-link", "erstat d-link switch",
                "installer scalance", "monter scalance switch", "monter scalance",
                "skift til scalance", "udskift med scalance switch", "udskift med scalance",
                "sæt scalance op", "sæt scalance switch op", "monter switch",
                "kobl mrp", "konfigurer mrp", "lås porte", "port security",
                "kobl scalance", "monter xb-200", "installer xb-200", "udskift med xb-200"
            }):
                self.install_scalance_switch()
                return True

        # Chapter 3: S7-1500 & PUT/GET / TIA Portal
        if self.chapter == 3:
            if any(k in cmd for k in {
                "tag backup", "lav backup", "backup s7-1500", "tag plc backup",
                "gem backup", "lav plc backup"
            }):
                self.flags.add("backup-taken")
                self.emit("[DRIFTSKONTINUITET]: Du tilslutter dit autoriserede USB-stik og tager en komplet offline backup af S7-1500 projektet og DB1.")
                self.emit("Hans McDonald klapper i hænderne: 'Fremragende! En god automationsteknolog rører aldrig en PLC uden en frisk backup!'")
                self.emit("Nu er du klar til sikkert at konfigurere TIA Portal og deaktivere PUT/GET.")
                return True
            if any(k in cmd for k in {
                "deaktiver put/get", "slå put/get fra", "kør security wizard",
                "aktiver complete protection", "start s7-1500", "sæt i run",
                "skift til run", "sikr s7-1500", "konfigurer plc", "hærd plc"
            }):
                self.use("tia portal", "s7-1500")
                return True

        # Chapter 4: OPC UA & Rogue 4G Router
        if self.chapter == 4:
            if any(k in cmd for k in {
                "frakobl 4g-router", "fjern 4g-router", "tag 4g-router ud",
                "kobl 4g-router fra", "fjern shadow it", "sluk 4g-router"
            }):
                self.flags.add("router-removed")
                self.emit("[IDMZ INTEGRITET]: Du trækker den uautoriserede Teltonika 4G-router ud af vægstikket og fjerner antennerne!")
                self.emit("Hans McDonald ryster på hovedet: 'Den der må en ekstern montør have sat op til 'hjemmearbejde'. Godt du fandt den!'")
                if "opc-hardened" in self.flags:
                    self.emit("\n✅ Både 4G-bagdøren og OPC UA mTLS krypteringen er nu på plads! IDMZ er 100% sikret!")
                    self.flags.add("chapter-4-done")
                    self.chapter = 5
                    self.emit("\n[SEJR] SAMTLIGE ANGREB ER AFVÆRGET! Kirsten fra Cybersikkerhedstilsynet er ankommet ved Hovedindgangen.")
                    self.emit("Gå til Hovedindgangen eller Kontrolrummet for at gennemføre den afsluttende NIS2-audit!")
                else:
                    self.emit("Sky-bagdøren er lukket. Nu skal OPC UA serveren hærdes med X.509 certifikater og SignAndEncrypt.")
                return True
            if any(k in cmd for k in {
                "konfigurer opc ua", "skift til signandencrypt", "installer certifikat",
                "installer x.509 certifikat", "fjern anonymous", "sikr opc ua server",
                "aktiver kryptering", "hærd opc ua"
            }):
                self.use("certifikat", "opc ua server")
                return True

        # Chapter 5: NIS2 Audit
        if self.chapter == 5:
            if any(k in cmd for k in {
                "fremlæg zoner", "fremlæg hændelseshåndtering", "fremlæg backup",
                "fremlæg dokumentation", "start audit", "tal med revisor",
                "gennemfør audit", "fremlæg for revisor", "afslut audit"
            }):
                self.complete_audit()
                return True

        return False

    def show_time(self) -> None:
        self.emit(
            f"[TID] Driftstid: Dag {self.simulated_day} af {self.workdays}, "
            f"time {self.simulated_hour} af {self.work_hours_per_day} | "
            f"Tid til revisoren ankommer: {self.time_display}"
        )
        if self.cavitation_deadline_active:
            self.emit(f"[!] AKUT KAVITATION-ALARM: Pumpe 2 destrueres om {self.cavitation_time_display}!")
        elif self.pump_deadline_active:
            self.emit(f"[!] AKUT ALARM: Pumpe 2 når sprængningsgrænse om {self.pump_time_display}!")

    def help(self) -> None:
        """Show general commands plus a hint for the current game situation."""
        self.emit(self.help_text())

    def help_text(self) -> str:
        """Build the help content without sending it through narrative output."""
        return (
            "===================== SPILKOMMANDOER =====================\n"
            "  UNDERSØG <objekt>         Undersøg et synligt hotspot for tekniske detaljer\n"
            "  BRUG <ting> PÅ <objekt>   Udfør en handling (f.eks. BRUG FIREWALL PÅ FREKVENSOMFORMER)\n"
            "  GÅ TIL <rum>              Skift zone (Indgangen, Pumpehuset, Ventil-øen, El-tavlen, Kontrolrummet)\n"
            "  ÅBN LAPTOP                Åbn din felttaske med IT/OT-værktøjer\n"
            "  ÅBN WIRESHARK             Start netværkssniffer på den aktuelle zone\n"
            "  ÅBN TIA PORTAL            Åbn simuleret Siemens konfiguration\n"
            "  ÅBN NMAP                  Udfør autoriseret portscanning af automationscellen\n"
            "  PURDUE / TOPOLOGI         Vis anlæggets zoner, conduits og Purdue-model\n"
            "  INVENTORY                 Vis værktøjer i din rygsæk\n"
            "  STATUS                    Vis aktuelt kapitel, mål og arbejdstid\n"
            "  RUNDTUR                   Hør senior driftsteknikers tekniske introduktion igen\n"
            "  TECHSUPPORT               Ring til UCL Tech Support for faglige råd (3 opkald)\n"
            "  NÆSTE SKRIDT              Åbn den guidede NIS2/IEC 62443 læringsvej\n"
            "==========================================================\n"
            f"Situationshint: {self.context_hint()}"
        )

    def context_hint(self) -> str:
        """Return the next useful hint without giving away the whole solution."""
        if self.chapter == 1:
            if self.room != "pumpehuset":
                return "Gå til Pumpehuset i produktionshallen for at se til anlægget."
            if "laptop-open" not in self.flags:
                return "Åbn laptoppen i Pumpehuset for at koble dig på netværket."
            if "wireshark-open" not in self.flags:
                return "Start Wireshark for at opsnappe den rå netværkstrafik på port 502."
            return (
                "Analyser de rå pakker i Wireshark. Læg mærke til hvem der sender Function Code 06. "
                "Konfigurer derefter SCALANCE S615 firewallen til at isolere frekvensomformeren med VLAN og Deep Packet Inspection."
            )
        if self.chapter == 2:
            return (
                "Gå til Ventil-øen. Åbn Wireshark for at inspicere Layer 2 PROFINET DCP pakkerne. "
                "Frakobl rogue Raspberry Pi og udskift switchen med SCALANCE managed switch med MRP og port security."
            )
        if self.chapter == 3:
            return (
                "Gå til Hoved-el-tavlen. Tag først en backup af S7-1500 til USB-stikket. "
                "Åbn derefter TIA Portal, deaktiver PUT/GET og kør Security Wizard for Complete Protection."
            )
        if self.chapter == 4:
            return (
                "Gå til Kontrolrummet. Frakobl den uautoriserede 4G-router i stikkontakten, "
                "og sikr derefter OPC UA serveren med Basic256Sha256, SignAndEncrypt og X.509 certifikater."
            )
        return (
            "Gå til Kontrolrummet eller Indgangen for at møde den eksterne NIS2-auditor. "
            "Fremlæg dokumentation for zoner/conduits, SIEM-logning, driftskontinuitet og forsyningskædesikkerhed."
        )

    def guidance(self) -> tuple[str, str, str, tuple[tuple[str, str], ...]]:
        """Return actionable pedagogical guidance aligned with NIS2 & IEC 62443."""
        if self.chapter == 1:
            if self.room != "pumpehuset":
                return (
                    OBJECTIVES[1],
                    "Du står ved Hovedindgangen. Pumpehuset ligger i produktionshallen.",
                    "Purdue Model Level 1: Basic Process Control.",
                    (
                        ("GÅ TIL PUMPEHUSET", "Gå direkte til pumperne i produktionshallen"),
                        ("UNDERSØG SKILT", "Se oversigten over anlæggets zoner"),
                    ),
                )
            if "laptop-open" not in self.flags:
                return (
                    OBJECTIVES[1],
                    "Pumpe 2 er under et aktivt overtryksangreb. Du skal koble dig på netværket og starte pakkeanalyse.",
                    "IEC 62443-3-3: Krav om monitorering og diagnosticering af procesnetværk.",
                    (
                        ("ÅBN LAPTOP", "Åbn din feltbærbare PC i pumpehuset"),
                        ("UNDERSØG PUMPE 2", "Aflæs det fysiske manometer på pumpen"),
                        ("UNDERSØG FREKVENSOMFORMER", "Undersøg SINAMICS frekvensomformerens display"),
                    ),
                )
            if "wireshark-open" not in self.flags:
                return (
                    OBJECTIVES[1],
                    "Laptoppen er tilsluttet. Brug Wireshark til at opsnappe de rå pakker og selv identificere hvad der foregår.",
                    "CISA ICS retningslinjer: Indsamling og analyse af rå pakkedata før ændring af produktionsudstyr.",
                    (
                        ("ÅBN WIRESHARK", "Start pakkefangst på VLAN 10 (Modbus TCP port 502)"),
                        ("UNDERSØG PUMPE 2", "Aflæs det fysiske manometer på pumpen"),
                    ),
                )
            return (
                OBJECTIVES[1],
                "Wireshark afslører, at en uautoriseret IP (10.20.1.77) overskriver frekvensomformerens setpunkt via rå Function Code 06 kommandoer. "
                "Da Modbus TCP på port 502 ikke har indbygget autentificering, skal forsvaret etableres via zonering og en industriel firewall (IEC 62443 conduit).",
                "IEC 62443-3-2: Zoner & Conduits samt NIS2 Art. 21 (Risikostyring og afbødning af teknologiske sårbarheder).",
                (
                    ("KONFIGURER FIREWALL PÅ FREKVENSOMFORMER", "Monter SCALANCE S615 på DIN-skinne, patch VFD til LAN-port og aktiver Modbus DPI (tillad FC 03, bloker FC 06)"),
                    ("ISOLER FREKVENSOMFORMER PÅ VLAN", "Adskil frekvensomformeren i en lukket sikkerhedszone jf. IEC 62443-3-2"),
                    ("ÅBN WIRESHARK", "Genåbn Wireshark for at genstudere de rå Modbus-pakker"),
                ),
            )
        if self.chapter == 2:
            return (
                OBJECTIVES[2],
                "Ventil-øen bombarderes med falske PROFINET DCP pakker og Layer 2 broadcast-storme. "
                "Brug Wireshark på feldbussen til at inspicere pakkerne. Find og frakobl den fysiske rogue enhed, "
                "og opgrader infrastrukturen med en managed switch med redundans og port-security.",
                "IEC 62443-3-3 & IEC 62439-2: Redundans via MRP, MAC-låsning på managed switche og DCP-lås i TIA Portal.",
                (
                    ("GÅ TIL VENTIL-ØEN", "Gå hen til de vildtfarende ventiler"),
                    ("ÅBN WIRESHARK", "Start Wireshark på PROFINET feldbussen for at inspicere DCP frames"),
                    ("UNDERSØG ROGUE RASPBERRY PI", "Inspicér den hemmelige enhed tapet på kabelbakken"),
                    ("FJERN RASPBERRY PI", "Fjern fysisk rogue Raspberry Pi'en fra netværket"),
                    ("UDSKIFT MED SCALANCE MANAGED SWITCH", "Erstat unmanaged switch med managed SCALANCE med MRP og Port Security"),
                ),
            )
        if self.chapter == 3:
            return (
                OBJECTIVES[3],
                "Hoved-el-tavlens S7-1500 Sikkerheds-PLC er sat i STOP-mode. Angriberen udnyttede, at indstillingen 'Permit access with PUT/GET' "
                "stod åben uden adgangskode på S7comm (Port 102). Husk altid backup FØR ændring af produktions-PLC!",
                "IEC 62443-4-2: Komponenthærdning & NIS2 Driftskontinuitet (Backup & Gendannelse).",
                (
                    ("GÅ TIL EL-TAVLEN", "Gå hen til hoved-el-tavlen"),
                    ("TAG BACKUP AF S7-1500", "Tag autoriseret offline backup til USB-stik før ændringer"),
                    ("ÅBN TIA PORTAL", "Undersøg PLC'ens sikkerhedsindstillinger i simuleret TIA Portal"),
                    ("DEAKTIVER PUT/GET OG KØR SECURITY WIZARD", "Fjern PUT/GET, sæt 4-trins adgangskode og TLS"),
                    ("BRUG TIA PORTAL PÅ S7-1500", "Udfør samlet sikkerhedskonfiguration og sæt CPU i RUN"),
                ),
            )
        if self.chapter == 4:
            return (
                OBJECTIVES[4],
                "En uautoriseret 4G-router i kontrolrummet skaber en uovervåget sky-bagdør uden om IDMZ'en. "
                "Samtidig kører en OPC UA server med Security Policy 'None' og tillader 'Anonymous' login, hvilket lækker batchdata og opskrifter.",
                "Purdue Model Level 3.5 IDMZ Adskillelse & IEC 62443-4-2 (OPC UA SignAndEncrypt med X.509 certifikater).",
                (
                    ("GÅ TIL KONTROLRUMMET", "Gå til kontrolrummet / IDMZ"),
                    ("FRAKOBL 4G-ROUTER", "Fjern den uautoriserede shadow-IT router fra stikkontakten"),
                    ("UNDERSØG OPC UA SERVER", "Inspicér de åbne endpoints på port 4840"),
                    ("KONFIGURER OPC UA TIL SIGNANDENCRYPT", "Aktiver Basic256Sha256, mTLS X.509 og fjern Anonymous"),
                    ("BRUG CERTIFIKAT PÅ OPC UA SERVER", "Standardkommando til installation af certifikater"),
                ),
            )
        return (
            OBJECTIVES[5],
            "Tilsynet er ankommet! Den eksterne NIS2-revisor (Kirsten) er klar med sit clipboard for at verificere overholdelse af NIS2 Artikel 21.",
            "NIS2 Direktiv (EU 2022/2555) Artikel 21: Risikovurdering, Zoner/Conduits, Beredskab, SIEM-logning og Forsyningskæde.",
            (
                ("GÅ TIL INDGANGEN", "Gå ud og byd revisoren velkommen"),
                ("FREMLÆG DOKUMENTATION", "Fremlæg den samlede tekniske dokumentationspakke"),
                ("REVISOR", "Gennemfør det afsluttende revisionsmøde"),
            ),
        )

    @property
    def time_remaining(self) -> int:
        if not self.timer_started_at:
            return self.timer_seconds
        return max(0, self.timer_seconds - int(time.monotonic() - self.timer_started_at))

    @property
    def time_display(self) -> str:
        remaining = self.time_remaining
        return f"{remaining // 60:02d}:{remaining % 60:02d}"

    @property
    def simulated_day(self) -> int:
        elapsed = self.timer_seconds - self.time_remaining
        return min(self.workdays, elapsed // self.day_seconds + 1)

    @property
    def simulated_hour(self) -> int:
        elapsed = self.timer_seconds - self.time_remaining
        elapsed_today = elapsed % self.day_seconds
        return min(
            self.work_hours_per_day,
            int(elapsed_today / self.day_seconds * self.work_hours_per_day),
        )

    @property
    def pump_time_remaining(self) -> int:
        if not self.pump_deadline_active:
            return 0
        return max(
            0,
            self.pump_deadline_seconds
            - int(time.monotonic() - self.pump_deadline_started_at),
        )

    @property
    def pump_time_display(self) -> str:
        if not self.pump_deadline_active:
            return "inaktiv"
        remaining = self.pump_time_remaining
        return f"{remaining // 60:02d}:{remaining % 60:02d}"

    @property
    def cavitation_time_remaining(self) -> int:
        if not self.cavitation_deadline_active:
            return 0
        return max(
            0,
            self.cavitation_deadline_seconds
            - int(time.monotonic() - self.cavitation_deadline_started_at),
        )

    @property
    def cavitation_time_display(self) -> str:
        if not self.cavitation_deadline_active:
            return "inaktiv"
        remaining = self.cavitation_time_remaining
        return f"{remaining // 60:02d}:{remaining % 60:02d}"

    def check_timers(self) -> bool:
        """Stop the game when either the work week or an active incident expires."""
        if self.pump_deadline_active and self.pump_time_remaining <= 0:
            self.expire_pump_timer()
            return False
        if self.cavitation_deadline_active and self.cavitation_time_remaining <= 0:
            self.expire_cavitation_timer()
            return False
        if self.time_remaining <= 0:
            self.expire_timer()
            return False
        return True

    def expire_timer(self) -> None:
        self.emit("[!] ARBEJDSUGEN ER SLUT. Auditoren ankommer, mens anlægget stadig er kompromitteret!")
        self.emit("Du dumper missionen. Nordic H2O Utility lukkes af tilsynet. Genstart og planlæg tiden bedre.")
        self.running = False

    def expire_pump_timer(self) -> None:
        self.emit("[KATASTROFE] PUMPE 2 HAR OVERSKREDET SPRÆNGNINGSGRÆNSEN (150 BAR)!")
        self.emit("Rørene sprang, pumpehuset er oversvømmet, og nødstop er udløst på hele fabrikken.")
        self.emit("Du nåede ikke at afværge hændelsen i tide. Missionen er tabt.")
        self.running = False

    def expire_cavitation_timer(self) -> None:
        self.emit("\n💥 [KATASTROFE] PUMPE 2'S PUMPEHJUL ER BLEVET SMADRET AF KAVITATION!")
        self.emit("Da modtrykket forsvandt under det ukontrollerede switch-udfald, opstod der voldsomme dampboble-implosioner mod skovlbladene.")
        self.emit("Vibrationssensoren udløste total nødnedlukning af vandværket. Tilsynet inddrager driftstilladelsen. Missionen er tabt.")
        self.running = False

    def tour(self) -> None:
        """Give players an orientation of the OT plant."""
        self.emit(
            "Hans McDonald tager dig med på rundtur gennem anlæggets zoner:\n"
            "  * [INDGANGEN / PERIMETER]: Fysisk adgangskontrol og besøgsregistrering.\n"
            "  * [KONTROLRUMMET / IDMZ (Purdue Level 3.5)]: SCADA-overvågning, historikserver og OPC UA integration.\n"
            "  * [PUMPEHUSET (Purdue Level 1)]: Centrifugalpumper, Siemens S7-1200 PLC og Modbus TCP frekvensomformere.\n"
            "  * [VENTIL-ØEN (Purdue Level 1)]: Decentral Festo ventil-ø og Siemens ET 200SP I/O over PROFINET RT (EtherType 0x8892).\n"
            "  * [HOVED-EL-TAVLEN (Purdue Level 1/2)]: Siemens S7-1500 Sikkerheds-PLC, SCALANCE S615 DPI firewall og switches."
        )
        self.emit(
            "Hans minder om den gyldne regel: 'I OT-sikkerhed er drift og personsikkerhed altid 1. prioritet. "
            "Undersøg altid mistænkelige ting grundigt, tag backup, og brug RUNDTUR eller TECHSUPPORT, hvis du sidder fast!'"
        )

    def call_tech_support(self) -> None:
        if self.help_calls >= self.max_help_calls:
            self.emit("[TECH SUPPORT] Din supportaftale er opbrugt. Du har kompetencerne - brug din faglige intuition!")
            return
        self.help_calls += 1
        hints = {
            1: (
                "Tech Support (UCL OT-Lab): 'I Pumpehuset skal du kigge på Modbus TCP på port 502. "
                "Protokollen er ukrypteret og uden adgangskontrol. Brug Wireshark til at finde angriberens IP. "
                "Løsningen jf. IEC 62443 er at isolere frekvensomformeren med et VLAN og konfigurere en SCALANCE S615 firewall med Deep Packet Inspection!'"
            ),
            2: (
                "Tech Support (UCL OT-Lab): 'PROFINET RT kører på Layer 2 uden IP-routing. Angribere udnytter ukrypteret DCP til at overskrive station navne. "
                "Find den fysiske rogue Raspberry Pi, fjern den, og skift den unmanaged switch ud med en SCALANCE switch med Media Redundancy Protocol (MRP) og MAC-låsning!'"
            ),
            3: (
                "Tech Support (UCL OT-Lab): 'S7-1500 i STOP-mode skyldes åben PUT/GET kommunikation på port 102 (S7comm). "
                "Husk: Tag ALTID en USB-backup først! Gå derefter i TIA Portal, fjern fluebenet i PUT/GET, kør Security Wizard og sæt CPU i RUN!'"
            ),
            4: (
                "Tech Support (UCL OT-Lab): 'OPC UA skal ALDRIG køre med Security Policy None eller Anonymous tilladt i produktion. "
                "Og tjek stikkontakterne for rogue 4G-modemer, der bryder IDMZ'en. Skift til Basic256Sha256 med SignAndEncrypt og X.509 certifikater!'"
            ),
            5: (
                "Tech Support (UCL OT-Lab): 'Auditoren tester dig på NIS2 Artikel 21: 1) Risikovurdering & Zoner/Conduits, "
                "2) Hændelseshåndtering (24t varsling/72t rapport), 3) Beredskab & Backup, og 4) Forsyningskædesikkerhed. Fremlæg med ro i stemmen!'"
            ),
        }
        self.emit(f"[TECH SUPPORT] ({self.help_calls}/{self.max_help_calls}):\n{hints[self.chapter]}")

    def status(self) -> None:
        self.emit(f"[STATUS] KAPITEL {self.chapter}/5 | Zone: {ROOMS[self.room].title} ({ROOMS[self.room].purdue_level})")
        self.emit(f"Mål: {OBJECTIVES[self.chapter]}")
        self.emit(
            f"Arbejdsdag {self.simulated_day}/5, time {self.simulated_hour}/8 | "
            f"Tid til audit: {self.time_display}"
        )
        if self.cavitation_deadline_active:
            self.emit(f"[!] AKUT KAVITATION-ALARM: {self.cavitation_time_display} tilbage før pumperne ødelægges!")
        elif self.pump_deadline_active:
            self.emit(f"[!] AKUT PUMPE 2 ALARM: {self.pump_time_display} tilbage før sprængning!")
        else:
            self.emit("[PROCES-STATUS]: Ingen aktive akutte overtryks- eller kavitationsalarmer.")
        self.emit(f"Tech Support: {self.max_help_calls - self.help_calls} opkald tilbage")

    def open_laptop(self) -> None:
        self.flags.add("laptop-open")
        self.flags.add("wireshark-open")
        self.emit(
            "[FELTTASKE / LAPTOP ÅBNET]:\n"
            "Tilgængelige værktøjer:\n"
            "  * [Wireshark]          Pakkefangst og protokol-dissektion på aktuel zone\n"
            "  * [TIA Portal]         Siemens SIMATIC S7 Hardware & Sikkerhedskonfiguration\n"
            "  * [Nmap]               Port- og sårbarhedsscanning på automationsnettet\n"
            "  * [Topologi / Purdue]  Vis plantens IEC 62443 zoner og conduits\n"
            "  * [NIS2 Rapport]       Dokumentationsstatus for audit\n\n"
            "Skriv f.eks. ÅBN WIRESHARK, ÅBN TIA PORTAL eller ÅBN NMAP."
        )

    def open_tool(self, tool: str) -> None:
        self.flags.add("laptop-open")
        normalized = tool.lower().strip()
        if "wireshark" in normalized:
            self.flags.add("wireshark-open")
            self.show_room_wireshark()
        elif "tia" in normalized or "portal" in normalized:
            self.flags.add("tia-open")
            plc_mode = "RUN (Grøn LED)" if "chapter-3-done" in self.flags else "STOP (Blinkende Rød LED - Afbrudt af eksternt job)"
            put_get = "[ ] Deaktiveret (Sikker)" if "chapter-3-done" in self.flags else "[X] AKTIVERET (SÅRBAR: Åben for alle på nettet)"
            protect = "[X] Complete Protection (Password-beskyttet)" if "chapter-3-done" in self.flags else "[ ] No protection (Adgang uden kodeord)"
            self.emit(
                "========================================================================================\n"
                "[SIEMENS TIA PORTAL V19 - HARDWARE CONFIG: PLC_1500 (CPU 1516F-3 PN/DP)]\n"
                "----------------------------------------------------------------------------------------\n"
                f"* CPU Driftstilstand:       {plc_mode}\n"
                f"* Connection Mechanisms:    {put_get}\n"
                f"* Access Level:             {protect}\n"
                "* Secure PG/PC & HMI:       " + ("[X] TLS 1.3 Certifikat aktivt" if "chapter-3-done" in self.flags else "[ ] Deaktiveret (Klartekst)") + "\n"
                "* Optimized Block Access:   [X] Aktiveret på DB1\n"
                "----------------------------------------------------------------------------------------\n"
                "OT-REGEL: Tag altid backup til USB før download af ændringer til produktions-PLC'er!"
            )
        elif "nmap" in normalized:
            self.emit(
                "========================================================================================\n"
                "[NMAP 7.94 SCAN - MÅL: 10.20.1.0/24 (AUTOMATIONSCELLER PÅ PURDUE L1/L2)]\n"
                "----------------------------------------------------------------------------------------\n"
                "PORT       STATE    SERVICE      DETALJER\n"
                "102/tcp    open     iso-tsap     Siemens SIMATIC S7comm (PUT/GET åben uden password!)\n"
                "502/tcp    open     modbus       Modbus TCP (Ingen autentificering / rå kontrol over VFD)\n"
                "802/tcp    closed   modbus-tls   Modbus Security (Ikke idriftsat endnu)\n"
                "4840/tcp   open     opc.tcp      OPC UA TCP Server (SecurityPolicy: None, Anonymous: TRUE)\n"
                "----------------------------------------------------------------------------------------\n"
                "SÅRBARHEDSVURDERING: Kritiske industrielle protokoller kører ukrypteret uden adgangskontrol."
            )
        elif "topologi" in normalized or "purdue" in normalized or "arkitektur" in normalized:
            self.emit(
                "========================================================================================\n"
                "[NORDIC H2O UTILITY - PURDUE MODEL & ZONEDELING (IEC 62443-3-2)]\n"
                "----------------------------------------------------------------------------------------\n"
                " [Level 4: Enterprise IT]        Kontor, ERP, Ekstern auditor\n"
                "          |\n"
                " ====== [IT/OT Firewall] ======  (Perimeter Conduit - Inspektion af al enterprise trafik)\n"
                "          |\n"
                " [Level 3.5: Industrial DMZ]     Kontrolrummet (SCADA Historian, Jump Host, OPC UA)\n"
                "          |                      " + ("[X] Shadow-IT 4G-router frakoblet!" if "chapter-4-done" in self.flags else "[!] Uautoriseret 4G-router i stikkontakt!") + "\n"
                " ====== [OT Conduit Firewall] == (Siemens SCALANCE S615 Deep Packet Inspection)\n"
                "          |\n"
                " [Level 2: Supervisory HMI]      WinCC SCADA arbejdsstation\n"
                "          |\n"
                " [Level 1: Basic Control Zone]   Siemens S7-1500 Sikkerheds-PLC, S7-1200, SINAMICS VFD,\n"
                "                                 ET 200SP ventil-ø, Festo ventilblokke\n"
                "          |\n"
                " [Level 0: The Process]          Centrifugalpumper (Pumpe 2), tryktransmittere, flowmålere\n"
                "========================================================================================"
            )
        elif "nis2" in normalized or "rapport" in normalized or "dokumentation" in normalized:
            c1 = "[OK] UDFØRT (VLAN & DPI Firewall)" if "chapter-1-done" in self.flags else "[X] MANGLER (Modbus sabotage aktiv)"
            c2 = "[OK] UDFØRT (SCALANCE MRP Switch & DCP-lås)" if "chapter-2-done" in self.flags else "[X] MANGLER (Rogue Pi & PROFINET kaos)"
            c3 = "[OK] UDFØRT (S7-1500 Hærdet & Backup på USB)" if "chapter-3-done" in self.flags else "[X] MANGLER (PLC i STOP / PUT/GET åben)"
            c4 = "[OK] UDFØRT (4G Fjernet & OPC UA SignAndEncrypt)" if "chapter-4-done" in self.flags else "[X] MANGLER (4G bagdør & åben OPC UA)"
            self.emit(
                "========================================================================================\n"
                "[NIS2 DOKUMENTATIONSMAPPE - NORDIC H2O UTILITY (EU 2022/2555 ARTIKEL 21)]\n"
                "----------------------------------------------------------------------------------------\n"
                f"1. Risikovurdering & Zoner/Conduits:  {c1}\n"
                f"2. Fysisk/Logisk Adgang & Redundans:  {c2}\n"
                f"3. Driftskontinuitet & Sikker Backup: {c3}\n"
                f"4. IDMZ-integritet & Kryptografi:     {c4}\n"
                "----------------------------------------------------------------------------------------\n"
                "Status: " + ("100% KLAR TIL REVISION!" if self.chapter == 5 else f"I gang ({self.chapter - 1}/4 kapitler gennemført)")
            )
        else:
            self.emit("Laptoppen kan åbne: WIRESHARK, TIA PORTAL, NMAP, TOPOLOGI eller NIS2.")

    def show_room_wireshark(self) -> None:
        """Render room-specific authentic packet captures without giving away spoilers."""
        self.flags.add("laptop-open")
        self.flags.add("wireshark-open")
        r = self.room
        if r == "pumpehuset":
            self.emit(
                "========================================================================================\n"
                "[WIRESHARK v4.2.0 - LIVE CAPTURE PÅ INTERFACE: eth0 (VLAN 10 - PUMPENETVÆRK)]\n"
                "Display Filter: modbus || tcp.port == 502                                     Pakker: 6\n"
                "----------------------------------------------------------------------------------------\n"
                "No.  Tid (s)    Afsender IP       Modtager IP       Proto    Info\n"
                "001  0.000000   10.20.1.5 (HMI)   10.20.1.20 (VFD)  Modbus   Query: Read Holding Registers (FC 03)\n"
                "002  0.000512   10.20.1.20 (VFD)  10.20.1.5 (HMI)   Modbus   Response: Read Holding Registers (FC 03)\n"
                "003  0.012480   10.20.1.77        10.20.1.20 (VFD)  Modbus   Query: Write Single Register (FC 06)\n"
                "004  0.012994   10.20.1.20 (VFD)  10.20.1.77        Modbus   Response: Write Single Register (FC 06)\n"
                "005  0.024810   10.20.1.77        10.20.1.20 (VFD)  Modbus   Query: Write Single Register (FC 06)\n"
                "006  0.025340   10.20.1.20 (VFD)  10.20.1.77        Modbus   Response: Write Single Register (FC 06)\n"
                "----------------------------------------------------------------------------------------\n"
                "[PAKKE-DETALJER FOR RAMME 003]:\n"
                "Frame 3: 66 bytes på kablet (528 bits)\n"
                "Internet Protocol Version 4, Src: 10.20.1.77, Dst: 10.20.1.20\n"
                "Transmission Control Protocol, Src Port: 49152, Dst Port: 502 (modbus)\n"
                "Modbus/TCP (MBAP Header)\n"
                "    Transaction Identifier: 0x0001\n"
                "    Protocol Identifier: 0x0000 (Modbus)\n"
                "    Length: 6\n"
                "    Unit Identifier: 1\n"
                "Modbus\n"
                "    Function Code: Write Single Register (0x06)\n"
                "    Reference Number: 0 (0x0000) [Frekvensomformer Setpunkt]\n"
                "    Data: 1337 (0x0539) [Dec: 1337]\n"
                "========================================================================================"
            )
        elif r == "ventil-oen":
            self.emit(
                "========================================================================================\n"
                "[WIRESHARK v4.2.0 - LIVE CAPTURE PÅ INTERFACE: eth1 (VLAN 20 - PROFINET FELDBUS)]\n"
                "Display Filter: pn_dcp || pn_rt                                               Pakker: 5\n"
                "----------------------------------------------------------------------------------------\n"
                "No.  Tid (s)    Afsender MAC         Modtager MAC         Proto    Info\n"
                "001  0.000000   00:1b:1b:22:33:44    01:0e:cf:00:00:00    PN-DCP   Identify Request (Broadcast)\n"
                "002  0.000412   b8:27:eb:d4:11:22    01:0e:cf:00:00:00    PN-DCP   Set Request: NameOfStation=\"rogue-io\"\n"
                "003  0.000950   b8:27:eb:d4:11:22    ff:ff:ff:ff:ff:ff    PN-DCP   Set Request: Reset to Factory (0x05)\n"
                "004  0.001820   b8:27:eb:d4:11:22    ff:ff:ff:ff:ff:ff    ETH      Layer 2 Broadcast Flood (0x8892)\n"
                "005  0.002410   00:1b:1b:22:33:44    00:1e:8c:aa:bb:cc    PN-RT    Real-Time Data: Frame Dropped (Jitter)\n"
                "----------------------------------------------------------------------------------------\n"
                "[PAKKE-DETALJER FOR RAMME 002]:\n"
                "Ethernet II, Src: b8:27:eb:d4:11:22 (Raspberry Pi Foundation), Dst: 01:0e:cf:00:00:00\n"
                "PROFINET DCP (Discovery and Basic Configuration Protocol)\n"
                "    Service ID: Set (0x04), Service Type: Request (0x00)\n"
                "    Block: Device Properties / NameOfStation\n"
                "    NameOfStation Value: \"rogue-io\"\n"
                "========================================================================================"
            )
        elif r == "el-tavlen":
            self.emit(
                "========================================================================================\n"
                "[WIRESHARK v4.2.0 - LIVE CAPTURE PÅ INTERFACE: eth2 (VLAN 30 - AUTOMATION BACKBONE)]\n"
                "Display Filter: s7comm || tcp.port == 102                                     Pakker: 5\n"
                "----------------------------------------------------------------------------------------\n"
                "No.  Tid (s)    Afsender IP       Modtager IP       Proto    Info\n"
                "001  0.000000   10.20.1.77        10.20.1.10 (PLC)  COTP     CR (Connection Request) tpdu-size: 1024\n"
                "002  0.000340   10.20.1.10 (PLC)  10.20.1.77        COTP     CC (Connection Confirm)\n"
                "003  0.001120   10.20.1.77        10.20.1.10 (PLC)  S7comm   Job: Setup Communication (PDU: 480)\n"
                "004  0.002480   10.20.1.77        10.20.1.10 (PLC)  S7comm   Job: Write Var (DB1.DBW0 -> 0x0539)\n"
                "005  0.003110   10.20.1.77        10.20.1.10 (PLC)  S7comm   Job: CPU Control Request (Function: STOP)\n"
                "----------------------------------------------------------------------------------------\n"
                "[PAKKE-DETALJER FOR RAMME 005]:\n"
                "Internet Protocol Version 4, Src: 10.20.1.77, Dst: 10.20.1.10\n"
                "Transmission Control Protocol, Src Port: 51234, Dst Port: 102 (iso-tsap)\n"
                "ISO-on-TCP (RFC 1006) / TPKT & COTP\n"
                "S7 Communication (Protocol ID: 0x32)\n"
                "    ROSCTR: Job (0x01)\n"
                "    Function: CPU Control / Stop (0x29)\n"
                "    Parameter: Force CPU to STOP Mode (PUT/GET er aktiv uden adgangskode)\n"
                "========================================================================================"
            )
        elif r == "kontrolrummet":
            self.emit(
                "========================================================================================\n"
                "[WIRESHARK v4.2.0 - LIVE CAPTURE PÅ INTERFACE: eth3 (IDMZ & SCADA PERIMETER)]\n"
                "Display Filter: opcua || tcp.port == 4840                                     Pakker: 4\n"
                "----------------------------------------------------------------------------------------\n"
                "No.  Tid (s)    Afsender IP       Modtager IP       Proto    Info\n"
                "001  0.000000   10.20.1.50        10.20.1.88 (OPC)  OPC-UA   Hello (OPC.TCP Transport)\n"
                "002  0.000510   10.20.1.88 (OPC)  10.20.1.50        OPC-UA   Acknowledge (PDU size: 65536)\n"
                "003  0.001420   10.20.1.50        10.20.1.88 (OPC)  OPC-UA   OpenSecureChannelRequest (None / None)\n"
                "004  0.002880   10.20.1.50        10.20.1.88 (OPC)  OPC-UA   ActivateSessionRequest (Anonymous)\n"
                "----------------------------------------------------------------------------------------\n"
                "[PAKKE-DETALJER FOR RAMME 003]:\n"
                "OPC UA Binary Protocol\n"
                "    Message Type: OPN (OpenSecureChannel)\n"
                "    Security Policy URI: \"http://opcfoundation.org/UA/SecurityPolicy#None\"\n"
                "    Message Security Mode: None (0x01) [Ingen kryptering / Ingen signering!]\n"
                "    User Identity Token: AnonymousIdentityToken\n"
                "========================================================================================"
            )
        else:
            self.emit(
                "========================================================================================\n"
                "[WIRESHARK v4.2.0 - LIVE CAPTURE PÅ INTERFACE: eth0 (ENTERPRISE ADGANGSZONE)]\n"
                "Display Filter: arp || dhcp || tcp.port == 443                                Pakker: 4\n"
                "----------------------------------------------------------------------------------------\n"
                "No.  Tid (s)    Afsender IP       Modtager IP       Proto    Info\n"
                "001  0.000000   10.10.0.1 (GW)    10.10.0.255       ARP      Who has 10.10.0.45? Tell 10.10.0.1\n"
                "002  0.001200   10.10.0.45        10.10.0.1         ARP      10.10.0.45 is at 00:0c:29:12:34:56\n"
                "003  0.015400   10.10.0.45        10.10.0.10 (AD)   DNS      Standard query A auditor.tilsyn.dk\n"
                "004  0.021100   10.10.0.45        192.168.1.1       TLSv1.3  Client Hello (Enterprise Portal)\n"
                "----------------------------------------------------------------------------------------\n"
                "[STATUS]: Almindelig administrativ netværkstrafik på kontornettet (Purdue Level 4).\n"
                "Gå til produktionszonerne (Pumpehus, Ventil-ø, El-tavle) for at inspicere den industrielle felttrafik.\n"
                "========================================================================================"
            )

    def get_wireshark_data(self) -> dict[str, Any]:
        """Return structured Wireshark packet data for the current zone."""
        self.flags.add("laptop-open")
        self.flags.add("wireshark-open")
        r = self.room
        if r == "pumpehuset":
            return {
                "interface": "eth0 (VLAN 10 - PUMPENETVÆRK)",
                "filter": "modbus || tcp.port == 502",
                "packets": [
                    {"no": "001", "time": "0.000000", "src": "10.20.1.5 (HMI)", "dst": "10.20.1.20 (VFD)", "proto": "Modbus", "info": "Query: Read Holding Registers (FC 03)", "detail": "Transaction ID: 0x0001, Protocol ID: 0x0000 (Modbus)\nLength: 6, Unit Identifier: 1\nFunction Code: Read Holding Registers (0x03)\nReference Number: 0 (Reg 40001), Word Count: 1\n[Normal cyklisk SCADA polling af driftstryk]"},
                    {"no": "002", "time": "0.000512", "src": "10.20.1.20 (VFD)", "dst": "10.20.1.5 (HMI)", "proto": "Modbus", "info": "Response: Read Holding Registers (FC 03)", "detail": "Byte Count: 2\nRegister Value: 42 (0x002a) [Nominelt tryk: 42.0 Bar]"},
                    {"no": "003", "time": "0.012480", "src": "10.20.1.77", "dst": "10.20.1.20 (VFD)", "proto": "Modbus", "info": "Query: Write Single Register (FC 06)", "detail": "Frame 3: 66 bytes on wire (528 bits)\nIP Src: 10.20.1.77, Dst: 10.20.1.20, Port: 502 (modbus)\nFunction Code: Write Single Register (0x06)\nReference Number: 0 (0x0000) [Frekvensomformer Setpunkt]\nData: 1337 (0x0539) [OVERSTYRET HASTIGHED -> 133.7 BAR!]"},
                    {"no": "004", "time": "0.012994", "src": "10.20.1.20 (VFD)", "dst": "10.20.1.77", "proto": "Modbus", "info": "Response: Write Single Register (FC 06)", "detail": "Echo Response: Register 0 = 1337 (0x0539)\nVFD accepterer det ondsindede setpunkt uden godkendelse!"},
                    {"no": "005", "time": "0.024810", "src": "10.20.1.77", "dst": "10.20.1.20 (VFD)", "proto": "Modbus", "info": "Query: Write Single Register (FC 06)", "detail": "Angriberens loop fastholder det ekstreme setpunkt.\nPumpe 2 nærmer sig sprængningsgrænsen på 150 Bar!"},
                    {"no": "006", "time": "0.025340", "src": "10.20.1.20 (VFD)", "dst": "10.20.1.77", "proto": "Modbus", "info": "Response: Write Single Register (FC 06)", "detail": "Echo Response: Register 0 = 1337"},
                ]
            }
        elif r == "ventil-oen":
            return {
                "interface": "eth1 (VLAN 20 - PROFINET FELDBUS)",
                "filter": "pn_dcp || pn_rt",
                "packets": [
                    {"no": "001", "time": "0.000000", "src": "00:1b:1b:22:33:44", "dst": "01:0e:cf:00:00:00", "proto": "PN-DCP", "info": "Identify Request (Broadcast)", "detail": "PROFINET DCP Broadcast over Layer 2 (EtherType 0x8892)"},
                    {"no": "002", "time": "0.000412", "src": "b8:27:eb:d4:11:22", "dst": "01:0e:cf:00:00:00", "proto": "PN-DCP", "info": "Set Request: NameOfStation=\"rogue-io\"", "detail": "Ethernet II, Src: b8:27:eb:d4:11:22 (Raspberry Pi Foundation)\nPROFINET DCP Service ID: Set (0x04)\nBlock: Device Properties / NameOfStation -> \"rogue-io\"\nAngriber kaprer Siemens ET 200SP ventil-øens stationsnavn!"},
                    {"no": "003", "time": "0.000950", "src": "b8:27:eb:d4:11:22", "dst": "ff:ff:ff:ff:ff:ff", "proto": "PN-DCP", "info": "Set Request: Reset to Factory (0x05)", "detail": "Falsk fabriksnulstilling sendes til alle PROFINET noder på bussen"},
                    {"no": "004", "time": "0.001820", "src": "b8:27:eb:d4:11:22", "dst": "ff:ff:ff:ff:ff:ff", "proto": "ETH", "info": "Layer 2 Broadcast Flood (0x8892)", "detail": "Massiv broadcast flood oversvømmer den unmanaged D-Link switch.\nKollisions-LED'er blinker i panisk takt!"},
                    {"no": "005", "time": "0.002410", "src": "00:1b:1b:22:33:44", "dst": "00:1e:8c:aa:bb:cc", "proto": "PN-RT", "info": "Real-Time Data: Frame Dropped (Jitter > 64ms)", "detail": "PROFINET Real-Time cyklus brudt pga. pakkeforsinkelse. Ventiler klaprer vildt!"},
                ]
            }
        elif r == "el-tavlen":
            return {
                "interface": "eth2 (VLAN 30 - AUTOMATION BACKBONE)",
                "filter": "s7comm || tcp.port == 102",
                "packets": [
                    {"no": "001", "time": "0.000000", "src": "10.20.1.77", "dst": "10.20.1.10 (PLC)", "proto": "COTP", "info": "CR (Connection Request) tpdu-size: 1024", "detail": "ISO-on-TCP (RFC 1006) Forbindelse oprettes til port 102"},
                    {"no": "002", "time": "0.000340", "src": "10.20.1.10 (PLC)", "dst": "10.20.1.77", "proto": "COTP", "info": "CC (Connection Confirm)", "detail": "Forbindelse godkendt af Siemens S7-1500"},
                    {"no": "003", "time": "0.001120", "src": "10.20.1.77", "dst": "10.20.1.10 (PLC)", "proto": "S7comm", "info": "Job: Setup Communication (PDU: 480)", "detail": "S7 Communication handshake fuldført uden kodeord (PUT/GET tilladt)"},
                    {"no": "004", "time": "0.002480", "src": "10.20.1.77", "dst": "10.20.1.10 (PLC)", "proto": "S7comm", "info": "Job: Write Var (DB1.DBW0 -> 0x0539)", "detail": "Uautoriseret skrivning direkte til proces-datablok DB1"},
                    {"no": "005", "time": "0.003110", "src": "10.20.1.77", "dst": "10.20.1.10 (PLC)", "proto": "S7comm", "info": "Job: CPU Control Request (Function: STOP)", "detail": "S7comm Function 0x29 (CPU Control / STOP)\nParameter: Force CPU to STOP Mode!\nS7-1500 standset af eksternt angreb!"},
                ]
            }
        elif r == "kontrolrummet":
            return {
                "interface": "eth3 (IDMZ & SCADA PERIMETER)",
                "filter": "opcua || tcp.port == 4840",
                "packets": [
                    {"no": "001", "time": "0.000000", "src": "10.20.1.50", "dst": "10.20.1.88 (OPC)", "proto": "OPC-UA", "info": "Hello (OPC.TCP Transport)", "detail": "TCP port 4840 opc.tcp transport handshake"},
                    {"no": "002", "time": "0.000510", "src": "10.20.1.88 (OPC)", "dst": "10.20.1.50", "proto": "OPC-UA", "info": "Acknowledge (PDU size: 65536)", "detail": "Server accepterer forbindelse"},
                    {"no": "003", "time": "0.001420", "src": "10.20.1.50", "dst": "10.20.1.88 (OPC)", "proto": "OPC-UA", "info": "OpenSecureChannelRequest (None / None)", "detail": "Security Policy URI: http://opcfoundation.org/UA/SecurityPolicy#None\nMode: None (INGEN KRYPTERING / INGEN SIGNATUR!)\nData transmitteres i klartekst uden beskyttelse!"},
                    {"no": "004", "time": "0.002880", "src": "10.20.1.50", "dst": "10.20.1.88 (OPC)", "proto": "OPC-UA", "info": "ActivateSessionRequest (Anonymous)", "detail": "User Identity Token: Anonymous (Adgang uden autentificering)\nRecepter og procesparametre lækker til internettet via 4G-router!"},
                ]
            }
        else:
            return {
                "interface": "eth0 (ENTERPRISE ADGANGSZONE)",
                "filter": "arp || dhcp || tcp.port == 443",
                "packets": [
                    {"no": "001", "time": "0.000000", "src": "10.10.0.1 (GW)", "dst": "10.10.0.255", "proto": "ARP", "info": "Who has 10.10.0.45? Tell 10.10.0.1", "detail": "Standard kontornetværkstrafik"},
                    {"no": "002", "time": "0.001200", "src": "10.10.0.45", "dst": "10.10.0.1", "proto": "ARP", "info": "10.10.0.45 is at 00:0c:29:12:34:56", "detail": "Normal ARP respons"},
                    {"no": "003", "time": "0.015400", "src": "10.10.0.45", "dst": "10.10.0.10 (AD)", "proto": "DNS", "info": "Standard query A auditor.tilsyn.dk", "detail": "DNS opslag for audit-portal"},
                    {"no": "004", "time": "0.021100", "src": "10.10.0.45", "dst": "192.168.1.1", "proto": "TLSv1.3", "info": "Client Hello (Enterprise Portal)", "detail": "Krypteret adgang til tilsynets portal"},
                ]
            }

    def get_process_status(self) -> dict[str, Any]:
        """Return real-time operational status for SCADA mimic and meters."""
        if self.breaker_tripped:
            pressure = 0.0
            p_text = "0.0 Bar (STRØMLØS - Relæ K1 udløst)"
        elif "chapter-1-done" in self.flags:
            pressure = 42.0
            p_text = "42.0 Bar (Stabil / Normal drift)"
        else:
            pressure = 133.7
            p_text = "133.7 Bar (KRITISK OVERTRYK!)"

        if "chapter-2-done" in self.flags:
            v_text = "Stabil / Deterministisk (<1ms jitter - MRP ring aktiv)"
        elif "pi-removed" in self.flags:
            v_text = "DCP storm stoppet - afventer SCALANCE switch & MRP ring"
        else:
            v_text = "KAOTISK (Layer 2 broadcast-storm / DCP-kapring)"

        if self.plc_defect_stop:
            plc_text = "DEFECTIVE STOP (Fejlkode 0x4542 - DB1 korrumperet)"
        elif "chapter-3-done" in self.flags:
            plc_text = "RUN (Grøn LED - Complete Protection & TLS aktiv)"
        else:
            plc_text = "STOP (Rød blink - Afbrudt via ubeskyttet PUT/GET)"

        if "chapter-4-done" in self.flags:
            opc_text = "Sikret (Basic256Sha256 / SignAndEncrypt / mTLS X.509)"
        else:
            opc_text = "SÅRBAR (SecurityPolicy: None / Anonymous tilladt / 4G bagdør)"

        done_count = sum(1 for c in [1, 2, 3, 4] if f"chapter-{c}-done" in self.flags)
        compliance_pct = int(done_count / 4 * 100)
        if self.breaker_tripped or self.scada_blind or self.plc_defect_stop or self.scada_log_interrupted:
            compliance_pct = max(0, compliance_pct - 25)
        if "router-removed" not in self.flags and self.chapter >= 4:
            compliance_pct = max(0, compliance_pct - 25)

        return {
            "pump_pressure": pressure,
            "pump_status": p_text,
            "valve_status": v_text,
            "plc_status": plc_text,
            "opc_status": opc_text,
            "compliance_pct": compliance_pct,
            "breaker_tripped": self.breaker_tripped,
            "scada_blind": self.scada_blind,
            "plc_defect_stop": self.plc_defect_stop,
            "scada_log_interrupted": self.scada_log_interrupted,
            "router_removed": "router-removed" in self.flags or "chapter-4-done" in self.flags,
            "pi_removed": "pi-removed" in self.flags or "chapter-2-done" in self.flags,
            "backup_taken": "backup-taken" in self.flags,
        }

    def get_hotspot_info(self, hotspot: str) -> dict[str, Any]:
        """Return rich equipment data and contextual actions for clicked hotspot."""
        h = hotspot.lower().strip()
        status_info = self.get_process_status()

        if h == "pumpe 2":
            return {
                "title": "PUMPE 2 (Centrifugal-højtrykspumpe)",
                "purdue": "Purdue Level 0: The Physical Process",
                "desc": f"Nominel effekt: 75 kW | Rør: DN150 rustfrit stål. Aktuelt tryk: {status_info['pump_status']}",
                "actions": [
                    ("🔍 Aflæs Manometer", "undersøg pumpe 2", "normal"),
                    ("⚡ Hård Nødnedlukning (Risiko: Vandslag)", "hård nødnedlukning af vfd", "danger") if "chapter-1-done" not in self.flags else ("✅ Normal Drift", "undersøg pumpe 2", "success"),
                    ("💻 Åbn Wireshark på VLAN 10", "åbn wireshark", "normal"),
                ]
            }
        elif h == "frekvensomformer":
            return {
                "title": "SINAMICS G120 Frekvensomformer",
                "purdue": "Purdue Level 1: Basic Process Control",
                "desc": "Styrer motorens omdrejningstal over Modbus TCP port 502." + (" [Sikret med SCALANCE S615 DPI]" if "chapter-1-done" in self.flags else " [SÅRBAR: Ubeskyttet kabel direkte i åben bus]"),
                "actions": [
                    ("🛠️ Monter SCALANCE S615 på DIN-skinne", "firewall workbench", "success") if "chapter-1-done" not in self.flags else ("🛡️ SCALANCE S615 Aktiv", "undersøg scalance s615", "success"),
                    ("⚠️ Juster Setpunkt Manuelt (Risiko)", "juster setpunkt", "danger") if "chapter-1-done" not in self.flags else ("✅ VFD Nomielt 50Hz", "undersøg frekvensomformer", "success"),
                    ("💻 Åbn Wireshark på VLAN 10", "åbn wireshark", "normal"),
                ]
            }
        elif h == "scada":
            return {
                "title": "Lokalt SCADA Operatørpanel (HMI)",
                "purdue": "Purdue Level 2: Supervisory Control",
                "desc": "Siemens Comfort Panel med WinCC overvågning. " + ("Viser frosset 42.0 Bar (Stuxnet vildledning)!" if "chapter-1-done" not in self.flags else "Viser live telemetri synkront med pumperne."),
                "actions": [
                    ("🔍 Undersøg SCADA Telemetri", "undersøg scada", "normal"),
                    ("💻 Åbn Laptop", "åbn laptop", "normal"),
                ]
            }
        elif h == "ventiler":
            return {
                "title": "Festo Ventil-ø (Pneumatisk styreblok)",
                "purdue": "Purdue Level 1: Distributed I/O Zone",
                "desc": f"Styres cyklisk af Siemens ET 200SP. Status: {status_info['valve_status']}",
                "actions": [
                    ("🔍 Undersøg Ventiler", "undersøg ventiler", "normal"),
                    ("⚠️ Genstart ET 200SP I/O (Risiko)", "genstart et200sp", "danger") if "chapter-2-done" not in self.flags else ("✅ MRP Deterministisk", "undersøg ventiler", "success"),
                    ("🦈 Wireshark: Inspicer PROFINET RT", "åbn wireshark", "normal"),
                ]
            }
        elif h in {"unmanaged switch", "d-link switch"}:
            return {
                "title": "Unmanaged D-Link Switch (100 Mbit)",
                "purdue": "Purdue Level 1: Feldbus Switch",
                "desc": "Billig unmanaged switch uden VLAN eller MAC-beskyttelse. " + ("Kollisions-LED'er blinker febrilsk af broadcast-storm!" if "chapter-2-done" not in self.flags else "Udskiftet med Siemens SCALANCE XB-200."),
                "actions": [
                    ("🛠️ Åbn Switch Montage-arbejdsbænk", "switch workbench", "success"),
