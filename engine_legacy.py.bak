    # MULTIPLE-CHOICE ACTION SELECTION ENGINE
    # =========================================================================
    def get_current_choices(self) -> list[tuple[str, str, str, str]]:
        """Return list of (key, label, command, category) for current state.

        Categories:
          - 'normal': informational / diagnostic (blue)
          - 'success': best-practice OT remediation (green)
          - 'danger': risky or hasty technician actions (red)
          - 'warning': navigation or cautionary steps (amber)
          - 'fix': remediating active cascading system consequences (purple)
        """
        r = self.room
        choices: list[tuple[str, str, str, str]] = []

        # 1. PUMPEHUSET
        if r == "pumpehuset":
            if self.breaker_tripped:
                choices.append(("1", "⚠️ VFD er strømløs efter vandslag! Gå til Hoved-el-tavlen og nulstil K1", "gå til el-tavlen", "fix"))
