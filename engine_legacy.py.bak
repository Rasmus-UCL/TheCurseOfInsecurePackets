                choices.append(("2", "🚶 Gå til Kontrolrummet (IDMZ)", "gå til kontrolrummet", "normal"))
                choices.append(("3", "🚶 Gå til Hoved-el-tavlen", "gå til el-tavlen", "normal"))
                choices.append(("4", "🔍 Undersøg emaljeskiltet med zonemodellen", "undersøg skilt", "normal"))
                choices.append(("5", "🔄 Tag en teknisk rundtur med Hans McDonald", "rundtur", "normal"))

        return choices

    def complete_audit(self) -> None:
        if self.chapter < 5:
            self.emit("Tilsynets auditor er ikke ankommet endnu. Du skal først løse de akutte sikkerhedshændelser i anlægget!")
            return

        flaws = []
        if self.breaker_tripped:
            flaws.append("Pumpe 2 er strømløs på grund af udløst sikkerhedsrelæ K1 (Artikel 21.2.c Driftskontinuitet)")
        if self.scada_blind:
            flaws.append("SCADA telemetri er blindet af en grov port-blokering frem for Deep Packet Inspection (Artikel 21.2.d Netværkssikkerhed)")
        if self.plc_defect_stop:
            flaws.append("S7-1500 PLC'en står i DEFECTIVE STOP med korrumperet DB1 (Artikel 21.2.c Backup & Gendannelse)")
        if self.scada_log_interrupted:
            flaws.append("Lovpligtig miljølogning til Miljøstyrelsen er afbrudt på grund af blokeret port 4840 (Artikel 21.2.h)")
        if "router-removed" not in self.flags:
            flaws.append("Uautoriseret 4G-router sidder fortsat tilsluttet i kontrolrummet (Artikel 21.2.a Shadow-IT)")

        if flaws:
            self.emit(
                "========================================================================================\n"
                "[REVISION AFVIST - NIS2 AFVIGELSER PÅVIST AF REVISOR KIRSTEN]\n"
                "----------------------------------------------------------------------------------------\n"
                "Revisor Kirsten kigger strengt op fra sit clipboard:\n"
                "\"Nordic H2O Utility kan IKKE godkendes i den nuværende tilstand jf. NIS2 Artikel 21!\n"
                "Følgende kritiske mangler blev konstateret under min tekniske inspektion:\n"
            )
            for flaw in flaws:
                self.emit(f"   ❌ {flaw}")
            self.emit(
                "\nUdbedr disse forhold i anlægget og præsenter dokumentationen igen!\"\n"
                "========================================================================================"
            )
            return

        self.emit(
            "========================================================================================\n"
            "[DEN ENDELIGE NIS2 & IEC 62443 REVISONSEKSAMEN]\n"
            "----------------------------------------------------------------------------------------\n"
            "Revisor Kirsten fra Cybersikkerhedstilsynet slår op på sit clipboard:\n"
            "\"Goddag! Lad os gennemgå Nordic H2O Utility's tekniske foranstaltninger jf. NIS2 Artikel 21:\n\n"
            "1. Risikovurdering & Netværkszoner (IEC 62443-3-2):\n"
            "   -> Du fremlægger: Frekvensomformere og pumper isoleret i VLAN 10 med SCALANCE S615 DPI firewall.\n"
            "   [GODKENDT - Fremragende afgrænsning af Level 1 conduits!]\n\n"
            "2. Fysisk/Logisk Adgang & Redundans (IEC 62439-2 & IEC 62443-3-3):\n"
            "   -> Du fremlægger: Rogue Pi fjernet, SCALANCE switch med MRP-ring og MAC-låsning på portene.\n"
            "   [GODKENDT - Robust Layer 2 determinisme og beskyttelse mod DCP-kapring!]\n\n"
            "3. Driftskontinuitet & Komponenthærdning (IEC 62443-4-2):\n"
            "   -> Du fremlægger: S7-1500 med PUT/GET deaktiveret, 4-trins Complete Protection og verificeret USB-backup.\n"
            "   [GODKENDT - Modelleret efter best-practice for industriel PLC-sikkerhed!]\n\n"
            "4. IDMZ & Kryptografisk Integritet:\n"
            "   -> Du fremlægger: Shadow-IT 4G router elimineret, OPC UA konfigureret med Basic256Sha256 og X.509 mTLS.\n"
            "   [GODKENDT - Ingen lækage af følsom proces-telemetri!]\n\n"
            "----------------------------------------------------------------------------------------\n"
            "RESULTAT: NORDIC H2O UTILITY BESTÅR NIS2-REVISIONEN MED UDMÆRKELSE!\n"
            "Jens Majer (Direktør) udbringer en skål i rent kildevand: 'Du har reddet anlægget, arbejdspladserne "
            "og vores driftstilladelse! Du er en sand mester i OT-cybersikkerhed!'\n"
            "Hans McDonald overrækker dig anlæggets gyldne RJ45-crimptang og en friskbrygget kop kaffe.\n"
            "========================================================================================"
        )
        self.flags.add("game-won")
        self.running = False
