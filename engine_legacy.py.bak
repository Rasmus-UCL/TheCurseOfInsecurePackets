                "purdue": "Purdue Level 1: Fysisk Trussel",
                "desc": "Sort kasse tapet fast bag kabelbakken med sort patchkabel ind i switchen. Udsender falske PROFINET DCP frames." if not status_info["pi_removed"] else "Frakoblet, konfiskeret og placeret i antistatisk evidenspose.",
                "actions": [
                    ("🔌 Frakobl & Konfisker Raspberry Pi", "fjern raspberry pi", "success") if not status_info["pi_removed"] else ("✅ Sikret i Evidenspose", "undersøg rogue raspberry pi", "normal"),
                    ("🔍 Undersøg Enhed", "undersøg rogue raspberry pi", "normal"),
