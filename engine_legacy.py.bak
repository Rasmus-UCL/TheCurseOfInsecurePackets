                choices.append(("3", "🔍 Undersøg SCADA PC log", "undersøg scada pc", "normal"))
                choices.append(("4", "🚶 Gå til Indgangen", "gå til indgangen", "normal"))
            elif self.chapter == 4:
                if "router-removed" not in self.flags:
                    choices.append(("1", "🔍 Undersøg det mistænkelige modem med antenner bag racket", "undersøg 4g-router", "normal"))
                    choices.append(("2", "🔌 Frakobl & konfisker den uautoriserede Teltonika 4G-router", "frakobl 4g-router", "success"))
                    choices.append(("3", "🦈 Wireshark: Inspicér rå OPC UA pakker på Port 4840", "åbn wireshark", "normal"))
                    choices.append(("4", "🚫 Bloker port 4840 totalt i IDMZ-firewallen (Grov blokering)", "bloker port 4840 totalt", "warning"))
                    choices.append(("5", "🔍 Undersøg OPC UA Server endpoints (SecurityPolicy: None)", "undersøg opc ua server", "normal"))
                    choices.append(("6", "🚶 Gå til Indgangen", "gå til indgangen", "normal"))
                else:
                    choices.append(("1", "🔐 Hærd OPC UA: Basic256Sha256, SignAndEncrypt, X.509 certifikat & fjern Anonymous", "brug certifikat på opc ua server", "success"))
                    choices.append(("2", "🦈 Wireshark: Bekræft krypteret OPC.TCP session", "åbn wireshark", "normal"))
                    choices.append(("3", "🔍 Undersøg WinCC SCADA PC", "undersøg scada pc", "normal"))
                    choices.append(("4", "🚶 Gå til Indgangen", "gå til indgangen", "normal"))
            elif self.chapter == 5:
                choices.append(("1", "🏆 Fremlæg NIS2 Artikel 21 dokumentation for Revisor Kirsten", "revisor", "success"))
                choices.append(("2", "📜 Tjek NIS2 compliance rapport på laptoppen", "nis2", "normal"))
                choices.append(("3", "☕ Snup en kop kaffe ved Moccamasteren med Hans McDonald", "undersøg kaffemaskine", "normal"))
                choices.append(("4", "🚶 Gå til Hovedindgangen for at møde revisoren", "gå til indgangen", "normal"))
            else:
                choices.append(("1", "🔍 Undersøg WinCC SCADA PC", "undersøg scada pc", "normal"))
                choices.append(("2", "☕ Undersøg kaffemaskinen", "undersøg kaffemaskine", "normal"))
                choices.append(("3", "🚶 Gå til Pumpehuset", "gå til pumpehuset", "normal"))
                choices.append(("4", "🚶 Gå til Hoved-el-tavlen", "gå til el-tavlen", "normal"))
                choices.append(("5", "🚶 Gå til Indgangen", "gå til indgangen", "normal"))

        # 5. INDGANGEN
        else:
            if self.chapter == 5:
                choices.append(("1", "🏆 Gennemfør den afsluttende NIS2 & IEC 62443 revision med Kirsten", "revisor", "success"))
                choices.append(("2", "📜 Fremlæg NIS2 dokumentationsmappe og forsyningskædesikkerhed", "nis2", "normal"))
                choices.append(("3", "🏭 Vis oversigtsdiagram over Purdue-zoner og conduits", "topologi", "normal"))
                choices.append(("4", "🗣️ Tal med Hans McDonald", "tal med hans", "normal"))
            else:
