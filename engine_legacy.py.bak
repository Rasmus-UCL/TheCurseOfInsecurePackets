                choices.append(("2", "🛠️ SCALANCE S615: Monter på DIN-skinne & konfigurer Modbus DPI", "firewall workbench", "success"))
                choices.append(("3", "🛑 Hård nødnedlukning: Træk hovedafbryderen til VFD under last (Risiko: Vandslag)", "hård nødnedlukning af vfd", "danger"))
                choices.append(("4", "🚫 Firewall: Bloker al TCP port 502 trafik i lag 3 switchen (Grov regel)", "bloker port 502 totalt", "warning"))
                choices.append(("5", "🔍 Undersøg Pumpe 2 fysiske manometer & vibrationer", "undersøg pumpe 2", "normal"))
                choices.append(("6", "🚶 Gå til Hoved-el-tavlen", "gå til el-tavlen", "normal"))
            else:
