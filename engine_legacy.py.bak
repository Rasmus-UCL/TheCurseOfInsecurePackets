            }
        elif h in {"hoveddør", "revisor"}:
            return {
                "title": "Nordic H2O Utility Perimeter & Indgang",
                "purdue": "Purdue Level 4: Enterprise & Adgangszone",
                "desc": "Revisor Kirsten fra Cybersikkerhedstilsynet venter med sit clipboard!" if self.chapter == 5 else "Hoveddør i børstet stål med RFID-kortlæser.",
                "actions": [
                    ("🏆 Gennemfør NIS2 Revision med Kirsten", "revisor", "success") if self.chapter == 5 else ("📜 Se NIS2 Dokumentationsstatus", "nis2", "normal"),
                    ("🗣️ Tal med Hans McDonald", "tal med hans", "normal"),
                    ("🏭 Se Purdue Topologi", "topologi", "normal"),
                ]
            }
        elif h == "skilt":
            return {
                "title": "Zonedeling & Sikkerhedsskilt",
                "purdue": "Purdue Level 4: Zonedelingsoversigt",
                "desc": "Viser opdelingen i Purdue-modellen: Level 1 (Produktion), Level 3.5 (IDMZ) og Level 4 (Enterprise).",
                "actions": [
                    ("🏭 Vis Fuld Purdue Topologi", "topologi", "normal"),
                    ("🔄 Tag Teknisk Rundtur", "rundtur", "normal"),
                ]
            }
        elif h == "kaffemaskine":
            return {
