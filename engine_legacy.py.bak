    def hard_shutdown_vfd(self) -> None:
        if "chapter-1-done" in self.flags or self.chapter > 1:
            self.emit("Frekvensomformeren er allerede sikret og kører i nominel drift.")
            return
        self.breaker_tripped = True
        self.emit(
            "\n💥 [HYDRAULISK VANDSLAG & ELEKTRISK UDFALD!]\n"
            "Du trækker hårdt i hovedafbryderen til frekvensomformeren, mens motoren pumper for fuld kraft under 133.7 Bar!\n"
            "Det abrupte stop sender en destruktiv trykbølge (vandslag / fluid hammer) tilbage gennem DN150-rørledningen!\n"
            "Rørene ryster voldsomt, og den induktive transient UDLØSER SIKKERHEDSRELÆ K1 i Hoved-el-tavlen!\n"
            "Frekvensomformeren er nu fuldstændig strømløs og død. Du kan hverken konfigurere den eller starte den,\n"
            "før du går til Hoved-el-tavlen og nulstiller sikkerhedsrelæ K1!"
        )

    def reset_safety_breaker(self) -> None:
        if not self.breaker_tripped:
            self.emit("Siemens SIRIUS sikkerhedsrelæ K1 i tavlen er allerede sluttet og i normal drift.")
            return
        if self.room != "el-tavlen":
            self.emit("Sikkerhedsrelæ K1 sidder fysisk i Hoved-el-tavlen. Gå derhen for at trykke på Reset-knappen!")
            return
        self.breaker_tripped = False
        self.emit(
            "\n🔄 [SIKKERHEDSRELÆ K1 NULSTILLET]:\n"
            "Du åbner lågen til el-tavlen og trykker på den blå 'Reset'-knap på Siemens SIRIUS sikkerhedsrelæet.\n"
            "Et kraftigt mekanisk 'KLIK' genlyder i rummet, og 400V styrespændingen vender tilbage til pumpehuset!\n"
            "Frekvensomformerens display tænder igen. Gå tilbage til Pumpehuset for at færdiggøre firewall-isoleringen!"
        )

    def block_port_502_blindly(self) -> None:
        if "chapter-1-done" in self.flags:
            self.emit("Frekvensomformeren er allerede beskyttet af en Modbus DPI conduit.")
            return
        self.scada_blind = True
        self.emit(
            "\n⚠️ [SYSTEMISK KONSEKVENS: SCADA OVERVÅGNING BLINDET!]\n"
            "Du oprettede en grov Layer 3 firewall-regel: 'DROP TCP PORT 502 ALLES'.\n"
            "Angriberens skrivepakker (FC 06) stoppes ganske vist, MEN det samme gør WinCC SCADA'ens lovlige telemetri-forespørgsler (FC 03)!\n"
            "SCADA-operatøren i kontrolrummet råber i radioen: 'Skærmen er frosset! Vi har mistet overvågningen af hele vandværket!'\n"
            "IEC 62443 kræver Deep Packet Inspection (DPI) i stedet for grov portblokering, så SCADA fortsat kan læse (FC 03), mens skriveordrer blokeres!"
        )

    def fix_scada_filter(self) -> None:
        if not self.scada_blind and "chapter-1-done" in self.flags:
            self.emit("Modbus DPI firewallen kører allerede med optimal filtrering.")
            return
        self.scada_blind = False
        self.emit(
            "\n🛡️ [MODBUS DPI REGELSÆT OPTIMERET]:\n"
            "Du opgraderer regelsættet på SCALANCE S615 til Modbus Deep Packet Inspection (DPI):\n"
            "  * TILLAD: Function Code 03 (Read Holding Registers) fra SCADA (10.20.1.5).\n"
            "  * BLOKER: Function Code 06 (Write Single) og FC 16 fra uautoriserede adresser (10.20.1.77).\n"
            "SCADA-operatøren melder lettet over radioen: 'Telemetrien er tilbage! Vi har fuld sigtbarhed på 42.0 Bar uden angrebstrafik!'"
        )
        if self.chapter == 1:
            self.flags.add("chapter-1-done")
            self.pump_deadline_active = False
            self.chapter = 2
            self.emit("\n[MÅL] NYT MÅL: Kapitel 2 aktiveret! Hans kalder over radioen: 'Skynd dig til VENTIL-ØEN! Ventilerne danser rundt i et PROFINET kaos!'")

    def manual_vfd_adjustment_fails(self) -> None:
        if "chapter-1-done" in self.flags:
            self.emit("Frekvensomformeren kører allerede stabilt på 50.0 Hz.")
            return
        if self.pump_deadline_active:
            self.pump_deadline_started_at -= 20.0
        self.emit(
            "\n⚠️ [LOKAL OVERSTYRING MISLYKKEDES!]\n"
            "Du forsøger manuelt at dreje potmeteret eller taste 50.0 Hz på VFD-betjeningspanelet.\n"
            "Men millisekunder efter overskriver angriberens rå Modbus FC 06 script setpunktet tilbage til 1337!\n"
            "Angriberens loop detekterer modstanden og skruer op for transmissionshastigheden!\n"
            "Manometeret hopper op på 146.5 Bar (farligt tæt på sprængningsgrænsen på 150 Bar)!\n"
            "Pumpe 2 hyler i smerte, og du taber 20 sekunder på pumpe-timeren!\n"
            "IEC 62443 læresætning: Du kan IKKE overstyre et netværksangreb med manuelle knapper på komponenten. "
            "Du er nødt til at etablere en netværksfirewall (conduit) med Deep Packet Inspection!"
        )

    def reboot_et200sp_fails(self) -> None:
        if "chapter-2-done" in self.flags:
            self.emit("Festo ventil-øen kører allerede deterministisk over MRP-ringen.")
            return
        self.emit(
            "\n⚠️ [GENSTART MISLYKKEDES: PROFINET DCP KAPRET IGEN!]\n"
            "Du afbryder 24V forsyningen til Siemens ET 200SP ventil-interfacet og tænder igen i håb om en frisk start.\n"
            "Idet modulet starter op med standardopsætning, detekterer den rogue Raspberry Pi omgående broadcast-forespørgslen!\n"
            "Angriberen sender et DCP Set-Name request og kaprer stationsnavnet til 'rogue-io' før S7-1500 PLC'en når det!\n"
            "Ventilerne begynder straks at klapre kaotisk igen med >140ms jitter!\n"
            "Hans McDonald råber: 'En genstart løser ingenting, så længe der sidder en rogue enhed på kablet! Frakobl den rogue Pi fra kabelbakken!'"
        )

    def force_run_without_protection(self) -> None:
        if self.chapter != 3 or "chapter-3-done" in self.flags:
            self.emit("S7-1500 PLC'en er allerede i stabil, beskyttet RUN-mode.")
            return
        self.plc_defect_stop = True
        self.emit(
            "\n💥 [KRITISK PLC FEJL: DB1 KORROMPERET!]\n"
            "Du drejede nøgleomskifteren til RUN uden først at lukke for PUT/GET eller tage backup!\n"
            "Angriberens script, der lytter på port 102, opdagede straks RUN-tilstanden og sendte en byte-bombe direkte ind i DB1.DBW0!\n"
            "S7-1500 CPU'en gik i blinkende rød 'DEFECTIVE STOP' med fejlkode 0x4542 (Memory Area Corrupted).\n"
            "Produktionen er lammet. Du er nødt til at genindlæse DB1 fra en autoriseret USB-backup, før CPU'en kan reddes!"
        )

    def restore_plc_db1(self) -> None:
        if not self.plc_defect_stop:
            if "backup-taken" in self.flags:
                self.emit("Du har allerede en frisk, gyldig backup på dit USB-stik.")
            else:
                self.flags.add("backup-taken")
                self.emit("[DRIFTSKONTINUITET]: Du tilslutter dit autoriserede USB-stik og gemmer en frisk backup af S7-1500 projektet og DB1.")
            return
        if self.room != "el-tavlen":
            self.emit("S7-1500 CPU'en og USB-interfacet findes i Hoved-el-tavlen. Gå derhen for at indsætte stikket.")
            return
        self.plc_defect_stop = False
        self.flags.add("backup-taken")
        self.emit(
            "\n💾 [PLC PROJEKT & DB1 GENDANNET FRA USB]:\n"
            "Du indsætter dit autoriserede USB-stik i PG/PC-interfacet og uploader en frisk, verificeret kopi af DB1.\n"
            "Hukommelseskorruptionen er udbedret, og fejlkode 0x4542 er nulstillet!\n"
            "Nu kan du gå i TIA Portal, deaktivere PUT/GET og køre Security Wizard sikkert!"
        )

