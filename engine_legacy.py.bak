                "actions": [
                    ("🔌 Frakobl 4G-router fra Stikkontakt", "frakobl 4g-router", "success") if not status_info["router_removed"] else ("✅ Bagdør Lukket", "undersøg 4g-router", "normal"),
                    ("🔍 Undersøg Router", "undersøg 4g-router", "normal"),
                ]
            }
        elif h == "opc ua server":
            return {
                "title": "OPC UA Server (Port 4840)",
                "purdue": "Purdue Level 3.5: Industrial DMZ",
                "desc": f"Status: {status_info['opc_status']}",
                "actions": [
                    ("🔐 Hærd OPC UA: Basic256Sha256 & X.509", "brug certifikat på opc ua server", "success") if "chapter-4-done" not in self.flags else ("✅ OPC UA Krypteret", "undersøg opc ua server", "success"),
                    ("🚫 Bloker Port 4840 i Firewall (Risiko: Log-fejl)", "bloker port 4840 totalt", "danger") if "chapter-4-done" not in self.flags else ("✅ mTLS Aktiv", "undersøg opc ua server", "normal"),
                    ("🦈 Wireshark: Inspicer OPC.TCP", "åbn wireshark", "normal"),
