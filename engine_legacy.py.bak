                "purdue": "Air-Gapped: 100% Cybersikker",
                "desc": "Gedigen hollandsk kaffemaskine. Hans McDonald: 'OT-driftens sande brændstof!'",
                "actions": [
                    ("☕ Drik en frisk kop kaffe", "undersøg kaffemaskine", "normal"),
                    ("🗣️ Snak med Hans", "tal med hans", "normal"),
                ]
            }

        return {
            "title": hotspot.title(),
            "purdue": "Purdue Level 1",
            "desc": "Industrielt automationsudstyr.",
            "actions": [("🔍 Undersøg", f"undersøg {hotspot}", "normal")]
        }

    def inspect(self, target: str) -> None:
        target_norm = target.lower().strip()
        room_hotspots = ROOMS[self.room].hotspots

        matched_hotspot = None
        for h in room_hotspots:
            if target_norm == h or target_norm in h or h in target_norm:
                matched_hotspot = h
                break

        if not matched_hotspot:
            self.emit(f"Du kigger dig omkring i {ROOMS[self.room].title}, men ser ingen '{target}'.")
            return

        h = matched_hotspot

        # 1. INDGANGEN
        if h == "hoveddør":
            if self.chapter == 5:
                self.emit(
                    "[HOVEDDØR]: Hoveddøren åbnes, og den eksterne NIS2-revisor (Kirsten fra Tilsynet) "
                    "træder ind i gul refleksvest med sit clipboard klar til den afsluttende revision."
                )
            else:
                self.emit(
                    "[HOVEDDØR]: En tung industridør i børstet stål med RFID-kortlæser. "
                    "Et advarselsskilt forkynder: 'Nordic H2O Utility - Autoriseret personale kun. "
                    "Overvåget område jf. IEC 62443 Zone 1'."
                )
            return

        if h == "skilt":
            self.emit(
                "[SKILT]: Et emaljeskilt på væggen viser anlæggets zoner: "
                "Kontrolrummet (Purdue Level 3.5 IDMZ) til venstre, "
                "og Hovedproduktionen (Purdue Level 1 Automationsceller) lige frem. "
                "En håndskrevet seddel fra direktøren: 'Audit om 5 dage - NIS2 compliance er et lovkrav!'."
            )
            return

        # 2. PUMPEHUSET
        if h == "pumpe 2":
            if "chapter-1-done" in self.flags:
                self.emit(
                    "[PUMPE 2]: Pumpe 2 kører fuldstændig stabilt og roligt. "
                    "Manometeret står klippefast på 42.0 Bar i den grønne zone. "
                    "Motoren summer med en behagelig 50 Hz frekvens, og temperaturerne er normale."
                )
            else:
                self.emit(
                    "[KRITISK OVERTRYK]: Manometeret på Pumpe 2 sitrer voldsomt på 133.7 Bar dybt inde i den røde farezone! "
                    "Pumpen hyler og vibrerer faretruende. Rørsamlingerne drypper. "
                    "Der er ingen mekaniske blokeringer - problemet skal findes i de digitale styresignaler, "
                    "som frekvensomformeren modtager over netværket!"
                )
            return

        if h == "scada":
            if self.scada_blind:
                self.emit(
                    "[SCADA]: Skærmen blinker gult med teksten: 'COMMUNICATION LOSS - PORT 502 UNREACHABLE'. "
                    "SCADA telemetri er afbrudt på grund af total portblokering i lag 3! "
                    "Konfigurer Modbus DPI i stedet, så SCADA FC 03 tillades, mens skriveordrer blokeres."
                )
            elif "chapter-1-done" in self.flags:
                self.emit(
                    "[SCADA]: Det lokale SCADA-operatørpanel viser nu korrekte, live telemetriværdier: "
                    "Tryk: 42.0 Bar, Flow: 120 m3/h. Kurverne følger pumpens fysiske manometer synkront, "
                    "og alarmhistorikken er kvitteret og arkiveret."
                )
            else:
                self.emit(
                    "[MISVISENDE TELEMETRI]: SCADA-skærmen viser bizart nok 'ALT NORMALT - 42.0 Bar', "
                    "selvom Pumpe 2 ved siden af er ved at sprænges! "
                    "Dette er et klassisk OT-angrebsmønster (kendt fra Stuxnet): "
                    "Angriberen narrer operatøren ved at fastfryse HMI-visningen, mens det fysiske anlæg stresses mod sprængning."
                )
            return

        if h == "frekvensomformer":
            if self.breaker_tripped:
                self.emit(
                    "[FREKVENSOMFORMER]: Displayet er helt mørkt og strømløst! "
                    "Hovedafbryderen og sikkerhedsrelæ K1 i Hoved-el-tavlen slog fra under det voldsomme hydrauliske vandslag. "
                    "Gå til Hoved-el-tavlen og nulstil Siemens SIRIUS relæ K1 for at genoprette 400V forsyningen."
                )
            elif "chapter-1-done" in self.flags:
                self.emit(
                    "[FREKVENSOMFORMER]: Siemens SINAMICS frekvensomformeren holder et stabilt setpunkt på 50.0 Hz. "
                    "Den er nu forbundet gennem SCALANCE S615 Deep Packet Inspection firewallen på VLAN 10, "
                    "som afviser alle uautoriserede Modbus FC 06 skriveforsøg."
                )
            else:
                self.emit(
                    "[FREKVENSOMFORMER]: SINAMICS frekvensomformeren styrer pumpemotorens omdrejningstal. "
                    "Det digitale 7-segments display viser, at setpunktet kontinuerligt overskrives af eksterne Modbus TCP kommandoer på port 502! "
                    "Kablet går direkte i en åben switch uden nogen firewall foran. Undersøg pakkerne i Wireshark og etabler en sikker conduit med en firewall."
                )
            return

        # 3. VENTIL-ØEN
        if h == "ventiler":
            if "chapter-2-done" in self.flags:
                self.emit(
                    "[VENTILER]: Festo ventil-øen arbejder med millimeterpræcis, deterministisk præcision. "
                    "De pneumatiske stempler åbner og lukker med en dæmpet hvislen efter PLC'ens cykliske PROFINET RT tidsplan."
                )
            else:
                self.emit(
                    "[PROCESKAOS]: Ventil-øen klaprer febrilsk som en maskingeværsalve! "
                    "Trykluftventilerne skyder ud i et tilfældigt mønster, og systemtrykket dykker brat. "
                    "Pumperne risikerer alvorlig kavitationsskade. Styresignalerne fra ET 200SP I/O-modulet forstyrres af netværksangreb."
                )
            return

        if h == "unmanaged switch":
            if "chapter-2-done" in self.flags:
                self.emit(
                    "[MANAGED SWITCH]: Den gamle switch er udskiftet med en robust Siemens SCALANCE XB-200 managed switch. "
                    "Den understøtter Media Redundancy Protocol (MRP) med sub-200ms ring-omskiftning, "
                    "og samtlige ubrugte RJ45-porte er låst med MAC-adresse port-security."
                )
            else:
                self.emit(
                    "[UNMANAGED SWITCH]: En billig, støvet unmanaged D-Link switch monteret med strips bag tavlen. "
                    "Samtlige LED-dioder blinker i panisk takt af en massiv Layer 2 broadcast-storm! "
                    "Switchen har ingen VLAN-opdeling, ingen port security og ingen beskyttelse mod broadcast floods."
                )
            return

        if h == "rogue raspberry pi":
            if "chapter-2-done" in self.flags or "pi-removed" in self.flags:
                self.emit(
                    "[ROGUE ENHED]: Rogue Raspberry Pi'en er sikkert afbrudt fra netværket, konfiskeret og placeret "
                    "i din antistatiske evidenspose til den tekniske NIS2 hændelsesrapport."
                )
            else:
                self.emit(
                    "[UAUTORISERET ENHED OPLEVET!]: En sort kasse med et rødt lysdiode - en Raspberry Pi 4 - "
                    "er tapet fast på indersiden af kabelbakken med et sort patchkabel ind i switchen! "
                    "Den udsender falske PROFINET DCP pakker for at kapre modulnavnet 'et200sp-ventil-01' og oversvømme bussen."
                )
            return

        # 4. HOVED-EL-TAVLEN
        if h == "s7-1500":
            if self.plc_defect_stop:
                self.emit(
                    "[S7-1500 PLC]: CPU'en blinker med en skarp rød 'DEFECTIVE STOP' fejl! "
                    "Displayet viser: 'FATAL ERROR 0x4542: DB1 Checksum mismatch / Memory Area Corrupted'. "
                    "Angriberen udnyttede RUN-tilstanden til at overskrive DB1 med tilfældige værdier. "
                    "Gendan DB1 og PLC-projektet fra dit autoriserede USB-backupstik for at vække CPU'en igen."
                )
            elif "chapter-3-done" in self.flags:
                self.emit(
                    "[S7-1500 PLC]: Siemens S7-1500 Sikkerheds-PLC'en lyser med en beroligende, konstant grøn RUN-LED. "
                    "Displayet viser: 'CPU 1516F-3 PN/DP: RUN | Complete Protection Active | Security Level 2'. "
                    "PUT/GET er slået fra, og al programmeringskommunikation er krypteret med TLS."
                )
            else:
                self.emit(
                    "[PLC I STOP-MODE]: Siemens S7-1500 CPU'en står med en skarpt blinkende rød STOP-diode. "
                    "På det indbyggede display står: 'STOP by external PG/PC command via Port 102'. "
                    "Angriberen udnyttede den sårbare indstilling 'Permit access with PUT/GET communication from remote partner', "
                    "som gav rå adgang til at overskrive datablokke uden adgangskode!"
                )
            return

        if h == "d-link switch":
            if "chapter-2-done" in self.flags or "chapter-3-done" in self.flags:
                self.emit(
                    "[D-LINK SWITCH]: Den aldrende unmanaged switch er koblet fra og lagt i kassen med udrangeret IT-skrot. "
                    "Infrastrukturen er nu 100% migreret til industrielle SCALANCE switche."
                )
            else:
                self.emit(
                    "[D-LINK SWITCH]: En gammel 100 Mbit switch. I en moderne automationsinstallation jf. IEC 62443 er unmanaged switche "
                    "en alvorlig sikkerhedsrisiko, da de ikke kan håndhæve VLAN eller port security."
                )
            return

        if h == "scalance s615":
            if "chapter-1-done" in self.flags or "chapter-3-done" in self.flags:
                self.emit(
                    "[SCALANCE S615]: Siemens SCALANCE S615 industriel sikkerhedsrouter/firewall er monteret på DIN-skinnen. "
                    "Dens grønne status-LED'er viser, at den filtrerer trafikken mellem Purdue Level 1 og Level 2 "
                    "med aktive Deep Packet Inspection regler (kun autoriserede Modbus FC 03 læsninger tillades)."
                )
            else:
                self.emit(
                    "[SCALANCE S615]: En fabriksny Siemens SCALANCE S615 industriel sikkerhedsrouter ligger stadig i sin papkasse på bunden af el-tavlen. "
                    "Hans McDonald indrømmer: 'Den har ligget der i et år, for vi nåede aldrig at sætte den op'. "
                    "Tid til at tage den i brug som conduit firewall!"
                )
            return

        # 5. KONTROLRUMMET
        if h == "scada pc":
            if self.scada_log_interrupted:
                self.emit(
                    "[SCADA PC]: Skærmen blinker med en rød advarsel: 'COMPLIANCE AUDIT LOG FAILURE'. "
                    "OPC UA miljø- og kvalitetslogningen er afbrudt på grund af total blokering af port 4840. "
                    "Konfigurer OPC UA med X.509 certifikater og mTLS for at genoprette den lovpligtige logning!"
                )
            elif "chapter-4-done" in self.flags:
                self.emit(
                    "[SCADA PC]: WinCC SCADA-arbejdsstationen kører roligt og stabilt med krypteret forbindelse mod historikserveren. "
                    "Post-it sedlerne med adgangskoder er makuleret, og alle hændelser logges centralt til Syslog/SIEM."
                )
            else:
                self.emit(
                    "[SCADA PC]: SCADA-arbejdsstationen viser alarmskærmen. WinCC loggen er oversvømmet med advarsler om forbindelsestab. "
                    "En gul post-it på skærmen bærer teksten 'Admin / Siemens2024!' - en klassisk menneskelig sårbarhed!"
                )
            return

        if h == "4g-router":
            if "chapter-4-done" in self.flags or "router-removed" in self.flags:
                self.emit(
                    "[4G-ROUTER]: Den uautoriserede 4G-router er hevet ud af stikket, konfiskeret og lagt i evidensposen. "
                    "IDMZ perimetret er genoprettet uden sky-bagdøre."
                )
            else:
                self.emit(
                    "[SHADOW-IT OPLEVET!]: En Teltonika 4G/LTE industri-router sidder sat direkte i en stikkontakt bag racket "
                    "med to magnetfods-antenner ført ud gennem vinduet! "
                    "Den danner en uautoriseret bagdør lige udenom virksomhedens IT/OT-firewall og forbinder IDMZ direkte til internettet!"
                )
            return

        if h == "opc ua server":
            if "chapter-4-done" in self.flags:
                self.emit(
                    "[OPC UA SERVER]: OPC UA serveren kører på port 4840 med Security Policy 'Basic256Sha256' og mode 'SignAndEncrypt'. "
                    "Anonymous login er deaktiveret, og samtlige klienter godkendes via X.509 certifikater i UaExpert Trust Listen."
                )
            else:
                self.emit(
                    "[ÅBNE DØRE]: En OPC UA server lytter på port 4840. "
                    "En hurtig Nmap/UaExpert scanning afslører: Security Policy: None, Mode: None, Anonymous Login: TILLADT! "
                    "Sensordata, kemikalieopskrifter og procesparametre flyder i rå klartekst ud på netværket uden autentificering!"
                )
            return

        if h == "kaffemaskine":
            self.emit(
                "[KAFFEMASKINE]: En gedigen Moccamaster brygger kulsort filterkaffe. "
                "Hans McDonald smiler: 'OT-driftens sande brændstof. Uden kaffe, ingen oppetid.' "
                "Den dufter fortræffeligt og er 100% air-gappet fra netværket."
            )
            return

        self.emit(f"Du undersøger {target_norm}, men finder ikke yderligere detaljer.")

    def talk_to(self, person: str) -> None:
        p = person.lower().strip()
        if any(k in p for k in {"bent", "hans", "mcdonald", "senior", "tekniker", "driftstekniker"}):
            dialogs = {
                1: (
                    "Hans McDonald nipper til sin kaffe: 'Pumpe 2 har aldrig opført sig sådan før! "
                    "Vores frekvensomformer lytter på Modbus TCP port 502. Åbn Wireshark på din laptop, "
                    "find ud af hvem der sender de skriveordrer, og isolér den bag den SCALANCE S615 firewall, der ligger i tavlen!'"
                ),
                2: (
                    "Hans McDonald ryster på hovedet: 'Ventil-øen er gået fuldstændig amok! "
                    "PROFINET RT bruger Layer 2 pakker. Nogen sender falske DCP-pakker. "
                    "Tjek den gamle D-Link switch bag tavlen - der sidder noget mistænkeligt!'"
                ),
                3: (
                    "Hans McDonald kigger nervøst på tavlen: 'S7-1500 står i STOP! "
                    "En montør satte vist flueben i PUT/GET for at teste et HMI-panel, og glemte at slå det fra. "
                    "Husk: Tag backup på USB'en først, før du retter det i TIA Portal!'"
                ),
                4: (
                    "Hans McDonald peger mod serverracket: 'Jeg så et mærkeligt modem med antenner i stikkontakten derinde. "
                    "Og vores OPC UA server sender åbenbart ukrypteret ud i verden. Få lukket den bagdør og sæt certifikater på!'"
                ),
                5: (
                    "Hans McDonald retter på kraven: 'Auditoren er her! Vis dem vores zoner, logning og backup-plan. "
                    "Du har styr på NIS2, det ved jeg!'"
                ),
            }
            self.emit(f"Hans McDonald: \"{dialogs.get(self.chapter, 'Gør Nordic H2O Utility stolt!')}\"")
        elif any(k in p for k in {"jens", "majer", "direktør"}):
            self.emit("Jens Majer (Direktør): 'Vores bestyrelse holder vejret. Hvis vi dumper NIS2-auditten, lukker fabrikken. Jeg stoler på dig!'")
        elif any(k in p for k in {"revisor", "auditor", "kirsten", "tilsyn"}):
            if self.chapter == 5:
                self.complete_audit()
            else:
                self.emit("Revisoren er endnu ikke ankommet. Du har stadig tid til at sikre anlægget!")
        else:
            self.emit("Der er ingen med det navn her. Kaffemaskinen bobler beroligende.")

    def go_to(self, destination: str) -> None:
        aliases = {
            "pumperne": "pumpehuset", "pumpehus": "pumpehuset", "pumpehuset": "pumpehuset",
            "ventil-øen": "ventil-oen", "ventiløen": "ventil-oen", "ventil": "ventil-oen", "ventiler": "ventil-oen",
            "ventil-oen": "ventil-oen", "ventiloen": "ventil-oen", "ventil oen": "ventil-oen", "ventil øen": "ventil-oen",
            "el-tavlen": "el-tavlen", "hoved-el-tavlen": "el-tavlen", "tavlen": "el-tavlen", "eltavle": "el-tavlen",
            "kontrolrummet": "kontrolrummet", "kontrolrum": "kontrolrummet", "dmz": "kontrolrummet", "idmz": "kontrolrummet",
            "indgangen": "indgangen", "indgang": "indgangen", "hovedindgang": "indgangen",
        }
        for rk in ROOMS:
            aliases[rk] = rk
        dest_norm = destination.lower().strip()
        clean = dest_norm.replace("ø", "oe").replace("å", "aa").replace("æ", "ae")
        target_room = aliases.get(dest_norm) or aliases.get(clean)
        if not target_room:
            self.emit("Ukendt destination. Gyldige zoner: INDGANGEN, PUMPEHUSET, VENTIL-ØEN, EL-TAVLEN, KONTROLRUMMET.")
            return
        if target_room == self.room:
            self.emit(f"Du befinder dig allerede i {ROOMS[self.room].title}.")
            return

        self.room = target_room
        self.describe_room()

        # Trigger acute pump deadline ONLY upon physically entering Pumpehuset!
        if self.room == "pumpehuset" and "chapter-1-done" not in self.flags and not self.pump_deadline_active:
            self.pump_deadline_started_at = time.monotonic()
            self.pump_deadline_active = True
            self.emit("\n🚨 [AKUT HÆNDELSE AKTIVERET!]: Idet du træder ind ad døren til Pumpehuset, gjalder sirenen!")
            self.emit("Pumpe 2 hyler voldsomt som en overophedet kedel! Manometeret vibrerer på 133.7 Bar og nærmer sig sprængningsgrænsen (150 Bar)!")
            self.emit("Du har 2 minutter til at afværge sprængningen! Åbn Wireshark på din laptop for at undersøge netværkstrafikken.")

    def use(self, item: str, target: str) -> None:
        item_norm = item.lower().strip()
        target_norm = target.lower().strip()

        # Chapter 1: Modbus Sabotage -> Realistic Firewall Conduit
        if self.chapter == 1:
            valid_items = {"firewall", "s615", "scalance", "scalance s615", "dpi", "vlan", "patchkabel", "konsolkabel"}
            valid_targets = {"frekvensomformer", "modbus", "pumpe 2", "vfd", "pumpehuset", "vlan", "switch"}
            if (any(i in item_norm for i in valid_items) or "firewall" in item_norm) and (any(t in target_norm for t in valid_targets) or "frekvens" in target_norm):
                if self.breaker_tripped:
                    self.emit("⚠️ Frekvensomformeren er strømløs! Sikkerhedsrelæ K1 i Hoved-el-tavlen slog fra under det hydrauliske vandslag.")
                    self.emit("Gå til Hoved-el-tavlen og nulstil K1, før du kan konfigurere eller forsyne frekvensomformeren!")
                    return
                if "wireshark-open" not in self.flags:
                    self.block_port_502_blindly()
                    return

                self.emit("🛡️ [LØSNING GENNEMFØRT - IEC 62443-3-2 ZONER & CONDUITS]:")
                self.emit("1) Du tager Siemens SCALANCE S615 sikkerhedsrouteren ud af kassen og klikker den solidt på DIN-skinnen i tavlen.")
                self.emit("2) Du patcher kablet: Frekvensomformerens netkabel flyttes fra den åbne bus over i firewallens sikrede LAN-port (VLAN 10 - VFD Zone).")
                self.emit("3) Du konfigurerer Modbus Deep Packet Inspection (DPI) regelsættet for TCP port 502:")
                self.emit("   * TILLAD: Function Code 03 (Read Holding Registers) fra autoriseret PLC (10.20.1.10).")
                self.emit("   * BLOKER & LOG: Function Code 06 (Write Single) og FC 16 (Write Multiple) fra uautoriserede adresser (10.20.1.77).")
                self.emit("   * DEFAULT POLICY: DROP uautoriseret trafik mod port 502.")
                self.emit("4) Firewallens dioder lyser grønt: Conduit'en er aktiv! De uautoriserede skrivepakker fra 10.20.1.77 afvises omgående.")
                self.emit("Manometeret på Pumpe 2 falder roligt fra 133.7 Bar til det nominelle driftstryk på 42.0 Bar. Alarmen er afværget!")
                self.flags.add("chapter-1-done")
                self.pump_deadline_active = False
                self.chapter = 2
                self.emit("\n[MÅL] NYT MÅL: Kapitel 2 aktiveret! Hans kalder over radioen: 'Skynd dig til VENTIL-ØEN! Ventilerne danser rundt i et PROFINET kaos!'")
                return

        # Chapter 2: PROFINET Kaos
        if self.chapter == 2:
            valid_items = {
                "switch", "scalance", "managed switch", "scalance managed switch",
                "patchkabel", "skruetrækker", "xb-200", "scalance xb-200",
                "scalance switch", "d-link switch"
            }
            valid_targets = {
                "unmanaged switch", "d-link switch", "ventil-øen", "switch",
                "d-link", "rogue raspberry pi", "raspberry pi", "ventil-oen"
            }
            if any(i in item_norm for i in valid_items) and any(t in target_norm for t in valid_targets):
                self.install_scalance_switch()
                return

        # Chapter 3: S7-1500 STOP Mode
        if self.chapter == 3:
            valid_items = {"tia portal", "tia portal simulator", "tia", "backup", "usb-stik", "usb-stik med backup"}
            valid_targets = {"s7-1500", "plc", "cpu", "el-tavlen"}
            if any(i in item_norm for i in valid_items) and any(t in target_norm for t in valid_targets):
                if self.plc_defect_stop:
                    self.emit("⚠️ S7-1500 CPU'en er låst i DEFECTIVE STOP på grund af hukommelseskorruption i DB1!")
                    self.emit("Gendan først DB1 fra dit autoriserede USB-backupstik, før CPU'en kan konfigureres!")
                    return
                if "backup-taken" not in self.flags:
                    self.plc_defect_stop = True
                    self.emit(
                        "\n💥 [KRITISK KONSEKVENS: MANGLENDE BACKUP FORUD FOR ÆNDRING!]\n"
                        "Du forsøgte at overføre ny hardware-konfiguration til S7-1500 uden først at have taget en offline USB-sikkerhedskopi (krav jf. NIS2 Artikel 21.2.c og IEC 62443-4-2)!\n"
                        "Under overførslen opstod et uheldigt afbrud, og datablok DB1 blev korrumperet!\n"
                        "CPU'en er gået i DEFECTIVE STOP med fejlkode 0x4542 (Memory Integrity Failure)!\n"
                        "Du er nu nødt til at indsætte dit autoriserede USB-stik og gendanne DB1 ('Gendan DB1 fra USB'), før du kan konfigurere PLC'en!"
                    )
                    return
                self.emit("[LØSNING GENNEMFØRT - IEC 62443-4-2]:")
                self.emit("1) I TIA Portal fjerner du fluebenet i 'Permit access with PUT/GET communication from remote partner'.")
                self.emit("2) Du kører Security Wizard og aktiverer 'Complete Protection' med et stærkt 4-trins adgangskodehierarki.")
                self.emit("3) Du aktiverer TLS-krypteret 'Secure PG/PC & HMI Communication'.")
                self.emit("4) Du sætter nøgleomskifteren til RUN: Den grønne RUN-LED lyser med det samme!")
                self.flags.add("chapter-3-done")
                self.chapter = 4
                self.emit("\n[MÅL] NYT MÅL: Kapitel 4 aktiveret! Hans melder: 'Vandrensningstanken lækker batchdata via en åben OPC UA server i kontrolrummet, og der er fundet et mistænkeligt modem!'")
                return

        # Chapter 4: OPC UA & 4G Router
        if self.chapter == 4:
            valid_items = {"certifikat", "x.509 certifikat", "tls", "x.509", "laptop", "usb-stik"}
            valid_targets = {"opc ua", "opc ua server", "4g-router", "server", "kontrolrummet"}
            if any(i in item_norm for i in valid_items) and any(t in target_norm for t in valid_targets):
                self.flags.add("opc-hardened")
                if "router-removed" not in self.flags:
                    self.emit(
                        "\n⚠️ [DELVIS LØSNING - SIKKERHEDSADVARSEL]:\n"
                        "Du konfigurerede Basic256Sha256 og installerede X.509 certifikater på OPC UA serveren.\n"
                        "OPC UA kommunikationen er nu krypteret, MEN den uautoriserede Teltonika 4G-router sidder stadig i stikkontakten bag racket!\n"
                        "SCADA-systemet alarmerer: 'Uautoriseret udgående LTE-forbindelse detekteret på Purdue Level 3.5!'\n"
                        "Frakobl og konfisker 4G-routeren for at lukke IDMZ-bagdøren 100% og opfylde NIS2 kravene!"
                    )
                    return
                self.emit("[LØSNING GENNEMFØRT - PURDUE LEVEL 3.5 IDMZ]:")
                self.emit("1) Den uautoriserede Teltonika 4G-router i stikkontakten er frakoblet og konfiskeret - IDMZ'en er igen isoleret mod internettet.")
                self.emit("2) På OPC UA serveren ændrer du endpoint til Security Policy 'Basic256Sha256' og Message Security Mode 'SignAndEncrypt'.")
                self.emit("3) Du genererer og installerer et gyldigt X.509 certifikat i serverens og klientens Trust List.")
                self.emit("4) 'Enable Anonymous Authentication' slås fra, og adgang begrænses til godkendte brugere via RBAC.")
                self.emit("Sensordata, recepter og procesparametre er nu 100% krypterede og sikrede!")
                self.flags.add("chapter-4-done")
                self.chapter = 5
                self.emit("\n[SEJR] SAMTLIGE ANGREB ER AFVÆRGET! Kirsten fra Cybersikkerhedstilsynet er ankommet ved Hovedindgangen.")
                self.emit("Gå til Hovedindgangen eller Kontrolrummet og skriv REVISOR eller FREMLÆG DOKUMENTATION for at gennemføre NIS2-auditten!")
                return

        self.emit("Det virker ikke rigtigt her. Undersøg objekterne grundigt eller klik på 'Næste skridt' for vejledning jf. standarderne.")

    def disconnect_switch_rashly(self) -> None:
        if "chapter-2-done" in self.flags:
            self.emit("Switchen er allerede sikkert udskiftet med en SCALANCE managed switch.")
            return
        if not self.cavitation_deadline_active:
            self.cavitation_deadline_active = True
            self.cavitation_deadline_started_at = time.monotonic()
            self.emit(
                "\n🚨 [AKUT PROCES-ALARM: TRYKFALD & PUMPE-KAVITATION UDLØST!]\n"
                "Du koblede D-Link switchen fra, mens den rogue Raspberry Pi stadig stormede nettet med falske DCP-pakker!\n"
                "Uden en redundant ring (MRP) mistede Siemens ET 200SP ventil-øen heartbeat-signalet til S7-1500 på under 64ms.\n"
                "Ventilerne låser øjeblikkeligt i uheldig position, modtrykket i DN150-hovedrøret forsvinder, og Pumpe 2 begynder at KAVITERE voldsomt!\n"
                "Skovlhjulene bombarderes af mikro-implosioner med skærende hyl! Hvis ikke flow og styring genoprettes hurtigt, ødelægges pumpen!\n"
                "DU HAR 90 SEKUNDER TIL AT FÅ SCALANCE SWITCHEN MONTERET, MRP-RINGEN FORBUNDET OG PROFINET RT GENOPRETTET!"
            )
        else:
            self.emit("Kavitations-alarmen er allerede i gang! Skynd dig at montere SCALANCE switchen og koble MRP-ringen!")

    def remove_rogue_pi(self) -> None:
        if "pi-removed" in self.flags or "chapter-2-done" in self.flags:
            self.emit("Rogue Raspberry Pi'en er allerede koblet fra og lagt i evidensposen.")
            return
        self.flags.add("pi-removed")
        self.emit(
            "🔌 [ROGUE ENHED FRAKOBLET & SIKRET]:\n"
            "Du trækker det sorte patchkabel ud af port 4 og piller forsigtigt den hemmelige Raspberry Pi af kabelbakken.\n"
            "Du pakker den i en antistatisk pose til NIS2 hændelsesrapporten.\n"
            "PROFINET DCP-broadcast stormen og name-spoofingen dør straks ud på bussen!"
        )
        if self.cavitation_deadline_active:
            self.emit("⚠️ Kavitations-alarmen kører stadig! Monter hurtigt SCALANCE XB-200 switchen og kobl MRP-ringkablerne!")
        else:
            self.emit("Næste skridt: Udskift den unmanaged D-Link switch med en Siemens SCALANCE managed switch (MRP & Port Security).")

    def install_scalance_switch(self) -> None:
        if "chapter-2-done" in self.flags:
            self.emit("SCALANCE XB-200 managed switchen er allerede idriftsat med MRP og port security.")
            return

        if "pi-removed" not in self.flags:
            self.cavitation_deadline_active = True
            if not self.cavitation_deadline_started_at:
                self.cavitation_deadline_started_at = time.monotonic()
            self.emit(
                "\n🚨 [PORT SECURITY VIOLATION & KAVITATION ALARM!]:\n"
                "Du monterede SCALANCE XB-200 switchen, MEN lod den rogue Raspberry Pi forblive forbundet til Port 4!\n"
                "Idet switchen starter op, forsøger angrebsenheden straks at oversvømme bussen med spoofed DCP-pakker!\n"
                "SCALANCE switch-interfacet lyser med en rød 'FAULT' diode: 'Port Security Violation detected on Port 4 (MAC b8:27:eb:d4:11:22)'.\n"
                "I/O-cyklussen til ET 200SP forstyrres, og Pumpe 2 begynder at KAVITERE voldsomt!\n"
                "Frakobl omgående den rogue Raspberry Pi fra kabelbakken for at afblæse kavitationen og fuldføre sikringen!"
            )
            return

        self.emit("🛡️ [LØSNING GENNEMFØRT - IEC 62443-3-3 & IEC 62439-2]:")
        self.emit("1) Du afmonterer den gamle unmanaged D-Link switch og kasserer den.")
        self.emit("2) Du monterer en industriel Siemens SCALANCE XB-200 managed switch på DIN-skinnen.")
        self.emit("3) Du tilslutter PROFINET-kablerne til Port 1 og Port 2 i en redundant MRP-ring (Media Redundancy Protocol).")
        self.emit("4) Du konfigurerer switch-management: Samtlige ubrugte RJ45-porte låses med MAC-adresse port-security.")
        self.emit("5) I TIA Portal låser du 'Name of Station' (DCP Write Disabled) mod eksterne ændringer.")

        if self.cavitation_deadline_active:
            self.emit("\n✅ [AKUT ALARM AFBLÆST]: MRP-ringen genetablerer PROFINET RT determinismen på 180 ms!")
            self.emit("Festo ventil-øen synkroniserer, trykfaldet stoppes, og Pumpe 2's tryk stabiliseres. Kavitationen er afværget!")
            self.cavitation_deadline_active = False

        self.emit("Ventil-øen arbejder nu med millimeterpræcis, deterministisk præcision uden pakketab!")
        self.flags.add("chapter-2-done")
        self.chapter = 3
        self.emit("\n[MÅL] NYT MÅL: Kapitel 3 aktiveret! Hans råber over radioen: 'Hoved-el-tavlen har fået et chok - S7-1500 PLC'en er gået i STOP-mode!'")

    # =========================================================================
    # SYSTEMIC CASCADING CONSEQUENCE HANDLERS
