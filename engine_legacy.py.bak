                "actions": [
                    ("🔍 Undersøg SCADA Arbejdsstation", "undersøg scada pc", "normal"),
                    ("🦈 Åbn Wireshark på IDMZ", "åbn wireshark", "normal"),
                ]
            }
        elif h == "4g-router":
            return {
                "title": "Teltonika 4G/LTE Router (Shadow-IT Bagdør)",
